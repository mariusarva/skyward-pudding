+    /// failed to open it keeps saying so, and is left alone.
+    pub fn decrypted(&mut self) {
+        if self.screen() != Screen::Decrypt || !matches!(self.state.data, Data::Open) {
+            return;
+        }
+        self.leave(true);
+        if self.stack.len() > 1 {
+            self.stack.pop();
+        } else {
+            *self.top_mut() = (Screen::Home, 0.0, Focus::Unset);
+        }
+        self.settle_page();
+        self.refresh();
+    }
