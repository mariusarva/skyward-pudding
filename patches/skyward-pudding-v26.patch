+/// How long a page waits for the phone's own parts before it goes ahead.
+#[cfg(target_os = "android")]
+const PREPARE_WAIT: std::time::Duration = std::time::Duration::from_secs(30);
+
+#[cfg(target_os = "android")]
+struct Gate {
+    done: std::sync::Mutex<bool>,
+    cv: std::sync::Condvar,
+}
+
+#[cfg(target_os = "android")]
+static PREPARED: std::sync::OnceLock<Gate> = std::sync::OnceLock::new();
+
+#[cfg(target_os = "android")]
+fn gate() -> &'static Gate {
+    PREPARED.get_or_init(|| Gate { done: std::sync::Mutex::new(false), cv: std::sync::Condvar::new() })
+}
+
+/// Say the phone's own parts are up, or that bringing them up failed: either
+/// way nothing is gained by waiting longer.
+#[cfg(target_os = "android")]
+fn mark_prepared() {
+    let gate = gate();
+    *gate.done.lock().unwrap_or_else(|e| e.into_inner()) = true;
+    gate.cv.notify_all();
+}
+
+/// Wait until the phone's own parts are up, and no longer than `PREPARE_WAIT`:
+/// a page that needs the partitions or the phone's services calls this first,
+/// so that the screen can be drawn before any of them are ready.
+#[cfg(target_os = "android")]
+pub(crate) fn wait_prepared() {
+    let gate = gate();
+    let done = gate.done.lock().unwrap_or_else(|e| e.into_inner());
+    if !*done {
+        let _ = gate.cv.wait_timeout(done, PREPARE_WAIT);
+    }
+}
+
+/// Whether the phone's own parts are up already, asked without waiting: a page
+/// drawn before they are says it waits for them rather than that it does the
+/// work they stand in the way of.
+#[cfg(target_os = "android")]
+pub(crate) fn prepared() -> bool {
+    *gate().done.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+/// The configuration to run by: the phone's own, where the ramdisk carries one
+/// for it, and the one the ramdisk was built with otherwise. A phone names
+/// itself through the bootloader, as `ro.boot.hardware.sku`, and through the
+/// kernel's command line where the property area has it not -- a ramdisk that
+/// holds several phones' configurations reads it before anything is mounted.
+#[cfg(target_os = "android")]
+fn device_config() -> Result<DeviceConfig> {
+    let named = skyward_sys::prop("ro.boot.hardware.sku")
+        .or_else(|| skyward_sys::prop("ro.boot.product.hardware.sku"))
+        .or_else(|| cmdline_value("androidboot.hardware.sku"))
+        .map(|name| name.trim().to_string())
+        .filter(|name| !name.is_empty());
+    if let Some(name) = &named {
+        let at = format!("/skyward/device-{name}.toml");
+        if Path::new(&at).is_file() {
+            skyward_sys::kmsg(&format!("the configuration for {name} is the one this ramdisk carries"))?;
+            return DeviceConfig::load(at);
+        }
+        skyward_sys::kmsg(&format!("this ramdisk carries no configuration for {name}; the one it was built with is used"))?;
+    } else {
+        skyward_sys::kmsg("the phone names itself nowhere; the configuration the ramdisk was built with is used")?;
+    }
+    DeviceConfig::load(Path::new("/").join(ramdisk::CONFIG))
+}
+
+/// What the kernel was told at `key=`, where it was told it.
+#[cfg(target_os = "android")]
+fn cmdline_value(key: &str) -> Option<String> {
+    let line = std::fs::read_to_string("/proc/cmdline").ok()?;
+    line.split_whitespace()
+        .find_map(|word| word.strip_prefix(key)?.strip_prefix('=').map(str::to_string))
+}
