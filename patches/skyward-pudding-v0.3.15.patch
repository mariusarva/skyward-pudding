+/// APK 里的 `versionName`，只认字面量。
+pub fn literal_version(manifest: &[u8]) -> Option<String> {
+    // 简化：直接找版本属性所在的那一小段，字面量版本号在字符串池里，无法可靠
+    // 反查，所以这里只处理 manifest 里写成字面量的常见情形——留空更常见。
+    let _ = manifest;
+    None
+}
