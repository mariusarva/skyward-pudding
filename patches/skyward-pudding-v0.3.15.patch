+/// How many bytes `url` hands over within [`SAMPLE_TIME`], asked for the first
+/// [`SAMPLE_BYTES`] only. Nothing is kept: this is a measurement.
+fn sample(agent: &ureq::Agent, url: &str) -> usize {
