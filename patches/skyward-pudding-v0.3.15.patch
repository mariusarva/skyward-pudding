+        let wlan = if on { l.pick(["WLAN · 已开", "WLAN · 已開", "WLAN · on"]) } else { l.pick(["WLAN · 已关", "WLAN · 已關", "WLAN · off"]) };
+        let tiles: [(ShadeHit, &str, bool); 4] = [
+            (ShadeHit::Wlan, wlan, on),
