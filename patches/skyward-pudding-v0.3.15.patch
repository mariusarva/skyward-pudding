+        out.fill_circle(m.dp(30.0), sheet - m.dp(30.0), m.dp(30.0), pane);
+        out.fill_circle(w - m.dp(30.0), sheet - m.dp(30.0), m.dp(30.0), pane);
+        out.fill_rect(m.dp(30.0), sheet - m.dp(30.0), w - m.dp(60.0), m.dp(30.0), pane);
