+/// 小药丸的点击区：竖直放宽到 44dp，手指略有抖动也算点在它上面。
+fn pill_hit(t: &Theme, x: f32, y: f32, w: f32, h: f32, action: Action) -> Hit {
+    let pad = (t.m.dp(44.0) - h).max(0.0) / 2.0;
+    Hit { rect: Rect::new(x - t.m.dp(4.0), y - pad, w + t.m.dp(8.0), h + pad * 2.0), action }
+}
