diff -ruN a/crates/skyward/src/fetch.rs b/crates/skyward/src/fetch.rs
--- a/crates/skyward/src/fetch.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/skyward/src/fetch.rs	2026-11-18 00:00:00.000000000 +0000
@@ -0,0 +1,157 @@
+//! Fetching one file from an address typed on the download page: on a thread
+//! of its own, so the page keeps up with how far it has come.
+
+use anyhow::{bail, Context, Result};
+use std::io::{Read, Write};
+use std::os::fd::{AsRawFd, FromRawFd, OwnedFd, RawFd};
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::mpsc::{self, Receiver};
+use std::sync::Arc;
+use std::thread::{self, JoinHandle};
+
+/// How much is read and written at a time.
+const CHUNK: usize = 1 << 16;
+
+/// How a fetch ended.
+pub enum Ended {
+    Done { path: PathBuf, bytes: u64 },
+    Failed(String),
+    Stopped,
+}
+
+pub struct Worker {
+    ended: Receiver<Ended>,
+    /// Readable once the fetch has ended.
+    wake: OwnedFd,
+    stop: Arc<AtomicBool>,
+    done: Arc<AtomicU64>,
+    /// How long the file is, or 0 where the server did not say.
+    total: Arc<AtomicU64>,
+    thread: Option<JoinHandle<()>>,
+}
+
+impl Worker {
+    pub fn start(url: String, path: PathBuf, servers: skyward_net::http::Servers) -> Result<Worker> {
+        let mut fds = [0; 2];
+        if unsafe { libc::pipe2(fds.as_mut_ptr(), libc::O_CLOEXEC | libc::O_NONBLOCK) } != 0 {
+            return Err(std::io::Error::last_os_error()).context("make the fetching thread's wake pipe");
+        }
+        let (wake, signal) = unsafe { (OwnedFd::from_raw_fd(fds[0]), OwnedFd::from_raw_fd(fds[1])) };
+        let stop = Arc::new(AtomicBool::new(false));
+        let done = Arc::new(AtomicU64::new(0));
+        let total = Arc::new(AtomicU64::new(0));
+        let (tx, ended) = mpsc::channel();
+        let (stop_as, done_as, total_as) = (stop.clone(), done.clone(), total.clone());
+        let thread = thread::Builder::new()
+            .name("fetch".into())
+            .spawn(move || {
+                let ended_as = match fetch(&url, &path, &stop_as, &done_as, &total_as, servers) {
+                    Ok(()) => Ended::Done { path: path.clone(), bytes: done_as.load(Ordering::Relaxed) },
+                    Err(e) if stop_as.load(Ordering::Relaxed) => {
+                        let _ = e;
+                        Ended::Stopped
+                    }
+                    Err(e) => Ended::Failed(format!("{e:#}")),
+                };
+                let _ = tx.send(ended_as);
+                unsafe { libc::write(signal.as_raw_fd(), [1u8].as_ptr().cast(), 1) };
+            })
+            .context("start the fetching thread")?;
+        Ok(Worker { ended, wake, stop, done, total, thread: Some(thread) })
+    }
+
+    pub fn fd(&self) -> RawFd {
+        self.wake.as_raw_fd()
+    }
+
+    /// How many bytes have come, and how many the server named where it did.
+    pub fn progress(&self) -> (u64, Option<u64>) {
+        let total = self.total.load(Ordering::Relaxed);
+        (self.done.load(Ordering::Relaxed), (total > 0).then_some(total))
+    }
+
+    /// How the fetch ended, once it has.
+    pub fn ended(&self) -> Option<Ended> {
+        let mut drain = [0u8; 8];
+        while unsafe { libc::read(self.wake.as_raw_fd(), drain.as_mut_ptr().cast(), drain.len()) } > 0 {}
+        self.ended.try_recv().ok()
+    }
+
+    pub fn stop(&self) {
+        self.stop.store(true, Ordering::Relaxed);
+    }
+}
+
+impl Drop for Worker {
+    fn drop(&mut self) {
+        self.stop();
+        if let Some(thread) = self.thread.take() {
+            let _ = thread.join();
+        }
+    }
+}
+
+/// The name a file from `url` is saved under: its last path segment, without
+/// the query, and made of characters a filesystem takes.
+pub fn name_of(url: &str) -> String {
+    let path = url.split(['?', '#']).next().unwrap_or("");
+    let last = path.rsplit('/').find(|s| !s.is_empty()).unwrap_or("");
+    let cleaned: String = last
+        .chars()
+        .map(|c| match c {
+            '/' | '\\' | ':' | '*' | '?' | '"' | '<' | '>' | '|' => '_',
+            c if c.is_control() => '_',
+            c => c,
+        })
+        .collect();
+    match cleaned.trim().is_empty() {
+        true => "download.bin".to_string(),
+        false => cleaned,
+    }
+}
+
+fn fetch(url: &str, path: &PathBuf, stop: &AtomicBool, done: &AtomicU64, total: &AtomicU64, servers: skyward_net::http::Servers) -> Result<()> {
+    let agent = skyward_net::http::agent(servers);
+    let head = agent.head(url).call().context("ask the server about the file")?;
+    let status = head.status().as_u16();
+    if status != 200 {
+        bail!("the server answered {status}");
+    }
+    if let Some(length) = head.headers().get("content-length").and_then(|v| v.to_str().ok()).and_then(|s| s.trim().parse::<u64>().ok()) {
+        total.store(length, Ordering::Relaxed);
+    }
+    if let Some(dir) = path.parent() {
+        std::fs::create_dir_all(dir).with_context(|| format!("make {}", dir.display()))?;
+    }
+    let mut response = agent.get(url).call().context("start the download")?;
+    let status = response.status().as_u16();
+    if status != 200 {
+        bail!("the server answered {status}");
+    }
+    let mut file = std::fs::File::create(path).with_context(|| format!("make {}", path.display()))?;
+    let mut body = response.body_mut().with_config().limit(u64::MAX).reader();
+    let mut buf = vec![0u8; CHUNK];
+    let mut have = 0u64;
+    loop {
+        if stop.load(Ordering::Relaxed) {
+            drop(file);
+            let _ = std::fs::remove_file(path);
+            bail!("stopped");
+        }
+        let n = body.read(&mut buf).context("download the file")?;
+        if n == 0 {
+            break;
+        }
+        file.write_all(&buf[..n]).with_context(|| format!("write {}", path.display()))?;
+        have += n as u64;
+        done.store(have, Ordering::Relaxed);
+    }
+    file.sync_all().with_context(|| format!("write {} through", path.display()))?;
+    if have == 0 {
+        drop(file);
+        let _ = std::fs::remove_file(path);
+        bail!("the server sent nothing");
+    }
+    Ok(())
+}
diff -ruN a/crates/skyward/src/fileserve.rs b/crates/skyward/src/fileserve.rs
--- a/crates/skyward/src/fileserve.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/skyward/src/fileserve.rs	2026-11-18 00:00:00.000000000 +0000
@@ -0,0 +1,480 @@
+//! A server on the network the phone is on, for the files in a folder: a
+//! browser on another device lists them, takes them, and puts others there.
+//!
+//! It answers on a port of its own, on every address the phone has, so that a
+//! computer that reached the phone over a router and one joined to the phone's
+//! own hotspot both find it.
+
+use anyhow::{Context, Result};
+use std::fs;
+use std::io::{BufRead, BufReader, Read, Write};
+use std::net::{TcpListener, TcpStream};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::Arc;
+use std::thread;
+use std::time::Duration;
+
+/// The port the files are served on.
+pub const PORT: u16 = 8080;
+
+/// The most a request's headers may take, and the most one upload may be.
+const HEAD_MAX: usize = 32 << 10;
+
+/// What the server is doing, as the page shows it.
+pub struct Server {
+    stop: Arc<AtomicBool>,
+    /// How many requests have been answered, so the page can say it is alive.
+    served: Arc<AtomicU64>,
+    thread: Option<thread::JoinHandle<()>>,
+}
+
+impl Server {
+    /// Serve the files under `root` on [`PORT`], until the server is stopped.
+    pub fn start(root: PathBuf) -> Result<Server> {
+        let listener = TcpListener::bind(("0.0.0.0", PORT)).with_context(|| format!("listen on port {PORT}"))?;
+        // Nothing waits in accept: a thread parked there would keep the port
+        // bound after the page is left, and the next visit could not serve it.
+        listener.set_nonblocking(true)?;
+        let stop = Arc::new(AtomicBool::new(false));
+        let served = Arc::new(AtomicU64::new(0));
+        let (flag, count) = (stop.clone(), served.clone());
+        let thread = thread::Builder::new()
+            .name("files".into())
+            .spawn(move || {
+                while !flag.load(Ordering::Relaxed) {
+                    match listener.accept() {
+                        Ok((stream, _)) => {
+                            let root = root.clone();
+                            let count = count.clone();
+                            // Each request is answered on its own thread, so a
+                            // large transfer does not hold up the rest.
+                            let _ = thread::Builder::new().name("files-req".into()).spawn(move || {
+                                let _ = answer(stream, &root);
+                                count.fetch_add(1, Ordering::Relaxed);
+                            });
+                        }
+                        Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => thread::sleep(Duration::from_millis(80)),
+                        Err(_) => thread::sleep(Duration::from_millis(80)),
+                    }
+                }
+            })
+            .context("start the thread serving the files")?;
+        Ok(Server { stop, served, thread: Some(thread) })
+    }
+
+    /// How many requests have been answered.
+    pub fn served(&self) -> u64 {
+        self.served.load(Ordering::Relaxed)
+    }
+}
+
+impl Drop for Server {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Relaxed);
+        if let Some(thread) = self.thread.take() {
+            let _ = thread.join();
+        }
+    }
+}
+
+/// One request: its method, its path, and what it carries.
+struct Request {
+    method: String,
+    path: String,
+    body: Vec<u8>,
+}
+
+fn answer(mut stream: TcpStream, root: &Path) -> Result<()> {
+    stream.set_read_timeout(Some(Duration::from_secs(30)))?;
+    stream.set_write_timeout(Some(Duration::from_secs(30)))?;
+    let Some(request) = read_request(&mut stream)? else { return Ok(()) };
+
+    // A path outside the folder served is turned away: `..` in an address must
+    // not reach the rest of the phone.
+    let wanted = match resolve(root, &request.path) {
+        Some(path) => path,
+        None => return reply(&mut stream, 403, "text/plain; charset=utf-8", b"forbidden"),
+    };
+
+    let _ = skyward_sys::kmsg(&format!("files: {} {}", request.method, request.path));
+    match request.method.as_str() {
+        "GET" | "HEAD" => {
+            // A link is followed to what it points at: /sdcard is one, and a
+            // link's own metadata says neither folder nor file.
+            let meta = fs::metadata(&wanted);
+            let is_dir = meta.as_ref().map(|m| m.is_dir()).unwrap_or(false);
+            let is_file = meta.as_ref().map(|m| m.is_file()).unwrap_or(false);
+            if is_dir {
+                let body = listing(root, &wanted);
+                let head = format!(
+                    "HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
+                    body.len()
+                );
+                stream.write_all(head.as_bytes())?;
+                if request.method == "GET" {
+                    stream.write_all(body.as_bytes())?;
+                }
+            } else if is_file {
+                let mut file = fs::File::open(&wanted).with_context(|| format!("open {}", wanted.display()))?;
+                let len = file.metadata()?.len();
+                let name = wanted.file_name().map(|n| n.to_string_lossy().into_owned()).unwrap_or_default();
+                // A name with anything but plain ASCII is put in the header's
+                // extended form, so that a browser takes the file rather than
+                // turning it away.
+                let plain: String = name.chars().filter(|c| c.is_ascii_graphic() || *c == ' ').collect();
+                let ascii = if plain == name && !plain.is_empty() { plain } else { "download".to_string() };
+                let encoded: String = name.bytes().map(|b| if b.is_ascii_alphanumeric() || b"-_.~".contains(&b) { (b as char).to_string() } else { format!("%{b:02X}") }).collect();
+                let head = format!(
+                    "HTTP/1.1 200 OK\r\nContent-Type: {kind}\r\nContent-Disposition: attachment; filename=\"{ascii}\"; filename*=UTF-8''{encoded}\r\nContent-Length: {len}\r\nAccept-Ranges: none\r\nConnection: close\r\n\r\n",
+                    kind = kind_of(&name),
+                );
+                stream.write_all(head.as_bytes())?;
+                if request.method == "GET" {
+                    let mut buf = vec![0u8; 1 << 16];
+                    loop {
+                        let n = file.read(&mut buf)?;
+                        if n == 0 {
+                            break;
+                        }
+                        stream.write_all(&buf[..n])?;
+                    }
+                }
+            } else {
+                reply(&mut stream, 404, "text/plain; charset=utf-8", b"not found")?;
+            }
+        }
+        "PUT" => {
+            if let Some(dir) = wanted.parent() {
+                let _ = fs::create_dir_all(dir);
+            }
+            fs::write(&wanted, &request.body).with_context(|| format!("write {}", wanted.display()))?;
+            reply(&mut stream, 201, "text/plain; charset=utf-8", b"written")?;
+        }
+        "DELETE" => match fs::remove_file(&wanted) {
+            Ok(()) => reply(&mut stream, 200, "text/plain; charset=utf-8", b"removed")?,
+            Err(_) => reply(&mut stream, 404, "text/plain; charset=utf-8", b"not found")?,
+        },
+        _ => reply(&mut stream, 405, "text/plain; charset=utf-8", b"not allowed")?,
+    }
+    Ok(())
+}
+
+/// The request `stream` carries, or nothing where it carries none.
+fn read_request(stream: &mut TcpStream) -> Result<Option<Request>> {
+    let mut reader = BufReader::new(stream.try_clone()?);
+    let mut line = String::new();
+    if reader.read_line(&mut line)? == 0 {
+        return Ok(None);
+    }
+    let mut parts = line.split_whitespace();
+    let method = parts.next().unwrap_or("").to_string();
+    let path = parts.next().unwrap_or("/").to_string();
+
+    // The headers, up to the empty line.
+    let mut length = 0usize;
+    let mut taken = 0usize;
+    loop {
+        let mut header = String::new();
+        let n = reader.read_line(&mut header)?;
+        if n == 0 {
+            break;
+        }
+        taken += n;
+        if taken > HEAD_MAX {
+            return Ok(None);
+        }
+        let trimmed = header.trim_end();
+        if trimmed.is_empty() {
+            break;
+        }
+        if let Some((name, value)) = trimmed.split_once(':') {
+            if name.trim().eq_ignore_ascii_case("content-length") {
+                length = value.trim().parse().unwrap_or(0);
+            }
+        }
+    }
+    let mut body = vec![0u8; length];
+    if length > 0 {
+        reader.read_exact(&mut body).with_context(|| format!("read the {length} bytes sent"))?;
+    }
+    Ok(Some(Request { method, path, body }))
+}
+
+fn reply(stream: &mut TcpStream, code: u16, kind: &str, body: &[u8]) -> Result<()> {
+    let head = format!(
+        "HTTP/1.1 {code} {}\r\nContent-Type: {kind}\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
+        match code {
+            200 => "OK",
+            201 => "Created",
+            403 => "Forbidden",
+            404 => "Not Found",
+            405 => "Method Not Allowed",
+            _ => "OK",
+        },
+        body.len()
+    );
+    stream.write_all(head.as_bytes())?;
+    stream.write_all(body)?;
+    Ok(())
+}
+
+/// The file `path` names, under `root`; nothing where it would reach outside.
+fn resolve(root: &Path, path: &str) -> Option<PathBuf> {
+    let path = path.split(['?', '#']).next().unwrap_or("/");
+    let decoded = percent_decode(path);
+    let mut out = root.to_path_buf();
+    for part in decoded.split('/') {
+        match part {
+            "" | "." => {}
+            ".." => return None,
+            name => out.push(name),
+        }
+    }
+    Some(out)
+}
+
+fn percent_decode(text: &str) -> String {
+    let bytes = text.as_bytes();
+    let mut out = Vec::with_capacity(bytes.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        match bytes[i] {
+            b'%' if i + 2 < bytes.len() => {
+                match u8::from_str_radix(&text[i + 1..i + 3], 16) {
+                    Ok(byte) => {
+                        out.push(byte);
+                        i += 3;
+                    }
+                    Err(_) => {
+                        out.push(b'%');
+                        i += 1;
+                    }
+                }
+            }
+            b'+' => {
+                out.push(b' ');
+                i += 1;
+            }
+            byte => {
+                out.push(byte);
+                i += 1;
+            }
+        }
+    }
+    String::from_utf8_lossy(&out).to_string()
+}
+
+/// The page that lists `dir`: a card for each entry, the way a drive on the
+/// web shows one, with a way up and a way to put files there.
+fn listing(root: &Path, dir: &Path) -> String {
+    let shown = dir.strip_prefix(root).map(|p| p.to_string_lossy().into_owned()).unwrap_or_default();
+    // The address of what is in this folder, made whole from the top.
+    let prefix = if shown.is_empty() { "/".to_string() } else { format!("/{}/", url_encode(&shown)) };
+    let mut cards = String::new();
+    if !shown.is_empty() {
+        cards.push_str(
+            "<a class=card href=\"../\"><div class=icon>&#8593;</div><div class=name>..</div><div class=meta>上级</div></a>\n",
+        );
+    }
+    let mut entries: Vec<_> = match fs::read_dir(dir) {
+        Ok(entries) => entries.filter_map(|e| e.ok()).collect(),
+        Err(_) => Vec::new(),
+    };
+    entries.sort_by_key(|e| {
+        let is_dir = e.file_type().map(|t| t.is_dir()).unwrap_or(false);
+        (!is_dir, e.file_name().to_string_lossy().to_lowercase())
+    });
+    for entry in entries {
+        let name = entry.file_name().to_string_lossy().into_owned();
+        let is_dir = entry.file_type().map(|t| t.is_dir()).unwrap_or(false);
+        let size = entry.metadata().map(|m| m.len()).unwrap_or(0);
+        let href = format!("{}{}{}", prefix, url_encode(&name), if is_dir { "/" } else { "" });
+        let (icon, meta) = if is_dir {
+            ("&#128193;".to_string(), "文件夹".to_string())
+        } else {
+            (icon_for(&name), size_of(size))
+        };
+        cards.push_str(&format!(
+            "<a class=card href=\"{href}\"><div class=icon>{icon}</div><div class=name title=\"{esc}\">{name}</div><div class=meta>{meta}</div></a>\n",
+            esc = html_escape(&name),
+        ));
+    }
+    if cards.is_empty() {
+        cards.push_str("<div class=empty>这个文件夹是空的</div>\n");
+    }
+
+    // The way up the tree, as breadcrumbs.
+    let mut crumbs = "<a href=\"/\">根目录</a>".to_string();
+    if !shown.is_empty() {
+        let mut walked = String::new();
+        for part in shown.split('/').filter(|p| !p.is_empty()) {
+            if !walked.is_empty() {
+                walked.push('/');
+            }
+            walked.push_str(part);
+            crumbs.push_str(&format!(" <span>/</span> <a href=\"{}/\">{}</a>", url_encode(&walked), html_escape(part)));
+        }
+    }
+
+    let count = cards.matches("class=card").count().saturating_sub(if shown.is_empty() { 0 } else { 1 });
+    format!(
