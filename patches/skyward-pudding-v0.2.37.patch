+                out.stroke_circle(cx, top + h / 2.0, size * 0.145, stroke, ink);
+            }
+            ShadeHit::Reboot => icons::glyph(out, Icon::Restore, cx, cy, size, ink),
+            ShadeHit::Brightness => {
+                // A sun: its disc and eight rays.
+                out.fill_circle(cx, cy, size * 0.19, ink);
