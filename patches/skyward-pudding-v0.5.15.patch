+                    let c = col.clamp(0, w as i64 - 1) as usize;
+                    src[(row * w + c) * 4 + ch] as u32
+                };
+                let mut sum: u32 = (-(half as i64)..=(half as i64)).map(at).sum();
+                for col in 0..w {
+                    dst[(row * w + col) * 4 + ch] = ((sum + width / 2) / width) as u8;
+                    sum = sum + at(col as i64 + half as i64 + 1) - at(col as i64 - half as i64);
+                }
+            }
+        }
+        std::mem::swap(&mut src, &mut dst);
+        for col in 0..w {
+            for ch in 0..4 {
+                let at = |row: i64| -> u32 {
+                    let r = row.clamp(0, h as i64 - 1) as usize;
+                    src[(r * w + col) * 4 + ch] as u32
+                };
+                let mut sum: u32 = (-(half as i64)..=(half as i64)).map(at).sum();
+                for row in 0..h {
+                    dst[(row * w + col) * 4 + ch] = ((sum + width / 2) / width) as u8;
+                    sum = sum + at(row as i64 + half as i64 + 1) - at(row as i64 - half as i64);
