+fn rest_card<'a>(
+    c: &mut Canvas,
+    t: &Theme,
+    f: &Fonts,
+    l: Lang,
+    y: f32,
+    out: &mut Vec<Hit>,
+    state: &State,
+    wlan: Option<&'a str>,
+    systems: Option<&'a str>,
+    skyward: Option<&'a str>,
+    entries: Vec<Entry>,
+) -> f32 {
+    if entries.is_empty() {
+        return y;
+    }
+    let name = if state.home_rest_name.is_empty() {
+        l.pick(["其他", "其他", "Others"]).to_string()
+    } else {
+        state.home_rest_name.clone()
+    };
+    let title = format!("{} · {}", name, entries.len());
+    section_card(c, t, f, l, y, out, &state.entry_names, wlan, systems, skyward, state.file_transfer, title, Icon::Folder, None, entries, state.home_rest_collapsed, Action::HomeFoldRest)
