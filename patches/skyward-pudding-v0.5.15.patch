+/// 挑栏目图标：全部图标排成格子，点一个就用它。
+pub fn home_icon(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let m = &t.m;
+    let mut c = long_page(cx);
+    let mut out = Vec::new();
+    let top = m.content_top;
+    let columns = 5usize;
+    let gap = m.dp(10.0);
+    let size = (m.w as f32 - m.margin * 2.0 - gap * (columns as f32 - 1.0)) / columns as f32;
+    let mut y = top;
+    for (at, icon) in crate::icons::ALL.iter().enumerate() {
+        let column = at % columns;
+        let row = at / columns;
+        let x = m.margin + column as f32 * (size + gap);
+        let at_y = y + row as f32 * (size + gap);
+        if *icon == s.section_icon {
+            // 选中的那枚加一圈浅底，一眼看得出来。
+            c.fill_round_rect(x - 4.0, at_y - 4.0, size + 8.0, size + 8.0, m.card_radius, t.pal.search);
+        }
+        icons::tile(&mut c, t, x + size / 2.0 - m.dp(24.0), at_y + size / 2.0 - m.dp(24.0), if *icon == s.section_icon { t.pal.accent } else { BLUE }, *icon);
+        out.push(Hit { rect: Rect::new(x, at_y, size, size), action: Action::HomePickIcon(at) });
+    }
+    let rows = crate::icons::ALL.len().div_ceil(columns);
+    y += rows as f32 * (size + gap);
+
+    // 图标的颜色：几个现成的色块，加一个「用主色」。
+    y = widgets::section(&mut c, t, f, y + m.card_gap, l.pick(["图标颜色", "圖示顏色", "Icon colour"]));
+    let swatches: [(Option<(u8, u8, u8)>, Rgba); 6] = [
+        (None, t.pal.accent),
+        (Some((74, 128, 247)), Rgba::rgb(74, 128, 247)),
+        (Some((226, 92, 78)), Rgba::rgb(226, 92, 78)),
+        (Some((60, 178, 128)), Rgba::rgb(60, 178, 128)),
+        (Some((238, 168, 58)), Rgba::rgb(238, 168, 58)),
+        (Some((150, 106, 228)), Rgba::rgb(150, 106, 228)),
+    ];
+    let d = m.dp(40.0);
+    let step = m.dp(52.0);
+    let mut hits_color = Vec::new();
+    for (k, (color, ink)) in swatches.into_iter().enumerate() {
+        let bx = m.margin + d / 2.0 + k as f32 * step;
+        let by = y + d / 2.0 + m.dp(8.0);
+        let on = s.section_icon_color == color;
+        if on {
+            c.stroke_circle(bx, by, d / 2.0 + m.dp(4.0), m.dp(2.0), t.pal.accent);
+        }
+        c.fill_circle(bx, by, d / 2.0, ink);
+        hits_color.push((
+            Rect::new(bx - step / 2.0, by - step / 2.0, step, step),
+            Action::HomePickIconColor(color),
+        ));
+    }
+    out.extend(hits(&hits_color.iter().map(|(r, _)| *r).collect::<Vec<_>>(), &hits_color.iter().map(|(_, a)| *a).collect::<Vec<_>>()));
+    y += d + m.dp(28.0);
+
+    let note = widgets::footnote(&mut c, t, f, y, l.pick(["点一个图标就用它，下面挑它的颜色", "點一個圖示就用它，下面挑它的顏色", "Tap an icon, then pick its colour below"]));
+    Frame::new(t, fit(c, t, note), out, l.pick(["选个图标", "選個圖示", "Pick an icon"]), top)
+}
