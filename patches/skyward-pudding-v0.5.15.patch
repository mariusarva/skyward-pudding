+/// 布局备份：首页的分组、顺序、名字、标题，以及控制中心的磁贴，写成
+/// 一个文件，也能从文件读回来（2026-11-27）。
+pub fn layout(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let m = &t.m;
+    let mut c = long_page(cx);
+    let mut out = Vec::new();
+    let mut y = m.content_top;
+
+    // 这一份现在是什么样：几栏、几条、几枚磁贴。
+    let held: usize = s.home_top.len() + s.home_rest.len() + s.home_sections.iter().map(|section| section.entries.len()).sum::<usize>();
+    let about = format!(
+        "{} {} · {} {} · {} {}",
+        l.pick(["分类", "分類", "Sections"]),
+        s.home_sections.len(),
+        l.pick(["条目", "條目", "Entries"]),
+        held,
+        l.pick(["磁贴", "磁貼", "Tiles"]),
+        s.tiles.len(),
+    );
+    y = widgets::section_first(&mut c, t, f, y, l.pick(["这一份", "這一份", "This one"]));
+    let card = widgets::list(
+        &mut c,
+        t,
+        f,
+        y,
+        &[
+            Row::new(&about).icon(BLUE, Icon::Layers),
+            Row::new(l.pick(["导出到存储", "匯出到儲存", "Write it to storage"])).icon(GREEN, Icon::Backup).trail(Trail::Arrow),
+            Row::new(l.pick(["导出到别处…", "匯出到別處…", "Write it elsewhere…"])).icon(GREEN, Icon::Folder).trail(Trail::Arrow),
+        ],
+    );
+    // 第一行只说这一份有多少，点了不动。
+    out.extend(hits(&card.rows[1..], &[Action::ExportLayout, Action::LayoutBrowseExport]));
+    y = card.bottom;
+
+    // 存储里的那些：点一条就按它改。
+    y = widgets::section(&mut c, t, f, y + m.card_gap, l.pick(["存储里的布局", "儲存裡的佈局", "Layouts in storage"]));
+    match &s.layouts {
+        None => y = widgets::footnote(&mut c, t, f, y, l.pick(["正在读……", "正在讀……", "Reading…"])),
+        Some(Err(why)) => y = widgets::footnote(&mut c, t, f, y, why),
+        Some(Ok(files)) if files.is_empty() => {
+            y = widgets::footnote(
+                &mut c,
+                t,
+                f,
+                y,
+                l.pick([
+                    "还没有导出过布局。导出一次，文件就落在存储的 Skyward 文件夹里。",
+                    "還沒有匯出過佈局。匯出一次，檔案就落在儲存的 Skyward 資料夾裡。",
+                    "Nothing written out yet: export once and the file lands in the Skyward folder in storage.",
+                ]),
+            )
+        }
+        Some(Ok(files)) => {
+            let rows: Vec<Row> = files
+                .iter()
+                .map(|file| Row::new(&file.name).icon(BLUE, Icon::Backup).trail(Trail::Arrow))
+                .collect();
+            let list = widgets::list(&mut c, t, f, y, &rows);
+            out.extend(hits(&list.rows, &(0..files.len()).map(Action::ImportLayout).collect::<Vec<_>>()));
+            y = list.bottom;
+        }
+    }
+    // 不在默认位置的文件：自己挑。
+    let elsewhere = widgets::list(
+        &mut c,
+        t,
+        f,
+        y + m.card_gap,
+        &[Row::new(l.pick(["从别处导入…", "從別處匯入…", "Take one from elsewhere…"])).icon(PURPLE, Icon::Folder).trail(Trail::Arrow)],
+    );
+    out.extend(hits(&elsewhere.rows, &[Action::LayoutBrowseImport]));
+    y = elsewhere.bottom;
+
+    let note = widgets::footnote(&mut c, t, f, y + m.dp(10.0), l.pick([
+        "导入会按文件里那一份改掉首页的分组、顺序、名字、标题，以及控制中心的磁贴；文件本身不动。文件名里的时间是导出它的那一刻。",
+        "匯入會按檔案裡那一份改掉首頁的分組、順序、名字、標題，以及控制中心的磁貼；檔案本身不動。檔名裡的時間是匯出它的那一刻。",
+        "Importing changes the home page's sections, order, names and title, and the control centre's tiles, to what the file holds; the file itself is left alone. The time in its name is when it was written out.",
+    ]));
+    Frame::new(t, fit(c, t, note), out, l.pick(["布局备份", "佈局備份", "Layout backup"]), m.content_top)
+}
+
+/// 挑布局的位置：导出时挑一个目录，导入时挑一个 `.json` 文件（2026-11-27）。
+pub fn layout_browse(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let m = &t.m;
+    let mut c = long_page(cx);
+    let mut out = Vec::new();
+    let mut y = m.content_top;
+    let exporting = s.layout_exporting;
+
+    // 现在在哪一层。
+    y = widgets::section_first(&mut c, t, f, y, s.layout_dir.path.as_str());
+    let up = widgets::list(
+        &mut c,
+        t,
+        f,
+        y,
+        &[Row::new(l.pick(["上一层", "上一層", "Up one level"])).icon(SLATE, Icon::Layers).trail(Trail::Arrow)],
+    );
+    out.extend(hits(&up.rows, &[Action::LayoutUp]));
+    y = up.bottom;
+    if exporting {
+        let here = widgets::list(
+            &mut c,
+            t,
+            f,
+            y + m.card_gap,
+            &[Row::new(l.pick(["导出到这一层", "匯出到這一層", "Write the layout here"]))
+                .icon(GREEN, Icon::Backup)
+                .trail(Trail::Arrow)],
+        );
+        out.extend(hits(&here.rows, &[Action::LayoutExportHere]));
+        y = here.bottom;
+    }
+
+    // 目录在前，`.json` 在后。
+    match &s.layout_dir.entries {
+        Err(why) => y = widgets::footnote(&mut c, t, f, y + m.card_gap, why),
+        Ok(entries) => {
+            let folders: Vec<&crate::app::FileRow> = entries
+                .iter()
+                .filter(|entry| matches!(entry.kind, crate::app::FileKind::Folder { .. }))
+                .collect();
+            let files: Vec<&crate::app::FileRow> = entries
+                .iter()
+                .filter(|entry| matches!(entry.kind, crate::app::FileKind::File) && entry.name.ends_with(".json"))
+                .collect();
+            y = widgets::section(&mut c, t, f, y + m.card_gap, l.pick(["目录", "目錄", "Folders"]));
+            if folders.is_empty() {
+                y = widgets::footnote(&mut c, t, f, y, l.pick(["这一层没有子目录", "這一層沒有子目錄", "No folders here"]));
+            } else {
+                let rows: Vec<Row> = folders.iter().map(|entry| Row::new(&entry.name).icon(BLUE, Icon::Folder).trail(Trail::Arrow)).collect();
+                let list = widgets::list(&mut c, t, f, y, &rows);
+                out.extend(hits(
+                    &list.rows,
+                    &(0..folders.len()).map(Action::LayoutEnter).collect::<Vec<_>>(),
+                ));
+                y = list.bottom;
+            }
+            if !exporting {
+                y = widgets::section(&mut c, t, f, y + m.card_gap, l.pick(["布局文件", "佈局檔案", "Layout files"]));
+                if files.is_empty() {
+                    y = widgets::footnote(&mut c, t, f, y, l.pick(["这一层没有 .json 文件", "這一層沒有 .json 檔案", "No .json files here"]));
+                } else {
+                    let rows: Vec<Row> = files.iter().map(|entry| Row::new(&entry.name).icon(PURPLE, Icon::Backup).trail(Trail::Arrow)).collect();
+                    let list = widgets::list(&mut c, t, f, y, &rows);
+                    out.extend(hits(
+                        &list.rows,
+                        &(0..files.len()).map(Action::LayoutPick).collect::<Vec<_>>(),
+                    ));
+                    y = list.bottom;
+                }
+            }
+        }
+    }
+
+    let note = l.pick(match exporting {
+        true => [
+            "挑一个目录，点「导出到这一层」就把布局写在那里；内部存储与 U 盘都能挑。",
+            "挑一個目錄，點「匯出到這一層」就把佈局寫在那裡；內部儲存與 U 盤都能挑。",
+            "Pick a folder, then write the layout there: internal storage and a USB drive both work.",
+        ],
+        false => [
+            "点一个 .json 文件就按它改布局；目录照常进去看。",
+            "點一個 .json 檔案就按它改佈局；目錄照常進去看。",
+            "Tap a .json file to lay it over the pages as it stands; folders open as usual.",
+        ],
+    });
+    let note = widgets::footnote(&mut c, t, f, y + m.dp(10.0), note);
+    Frame::new(t, fit(c, t, note), out, l.pick(["挑一个位置", "挑一個位置", "Choose a place"]), m.content_top)
+}
+
+/// 自定义强调色：开关、按钮、进度条和磁贴用的那一个主色。留着不改就用
+/// 主题自带的（2026-11-28）。
+pub fn accent(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let m = &t.m;
+    let mut c = long_page(cx);
+    let mut out = Vec::new();
+    let mut y = m.content_top;
+
+    // 壁纸摆在最上面：先看到「挑一张图」，再往下才是配色
+    // （2026-11-28 主人要求）。滑杆一组也折起来，默认收起。
+    // 折叠用的那一行：右边一枚圆钮，圆钮左边一枚「展开 / 收起」的小字，
+    // 整行都能点（2026-11-28 主人要求加提示）。
+    let fold_row = |c: &mut Canvas, out: &mut Vec<Hit>, at: usize, open: bool, cy: f32| {
+        let d = m.dp(30.0);
+        let bx = m.w as f32 - m.margin - d / 2.0 - m.dp(2.0);
+        widgets::fold_button(c, t, bx, cy, d, !open);
+        let hint = if open {
+            l.pick(["收起", "收起", "Hide"])
+        } else {
+            l.pick(["展开", "展開", "Show"])
+        };
+        let px = m.dp(12.0);
+        let w = c.text_width(&f.body, hint, px);
+        c.text(&f.body, hint, bx - d / 2.0 - m.dp(8.0) - w, cy + px * 0.36, px, t.pal.subtitle, None);
+        out.push(Hit {
+            rect: Rect::new(m.margin, cy - d / 2.0, m.w as f32 - m.margin * 2.0, d),
+            action: Action::FoldPalette(at),
+        });
+    };
+
+    let wall_open = s.palette_open.get(3).copied().unwrap_or(false);
+    // 标题和下面三组用同一套画法（`f.heading` + dp(19)、同一条基线），
+    // 折角的圆钮才落得一样高（2026-11-28 主人：壁纸那枚偏低）。
+    {
+        let head_y = y;
+        let label_top = head_y + m.section_label_top;
+        c.text(&f.heading, l.pick(["壁纸", "壁紙", "Wallpaper"]), m.margin + m.dp(2.0), label_top + m.dp(6.0), m.dp(19.0), t.pal.section, None);
+        fold_row(&mut c, &mut out, 3, wall_open, label_top + m.dp(6.0) - m.dp(7.0));
+        y = head_y + m.section_block;
+    }
+    // 当前这张长什么样：一条居中的预览，左右各留两倍边距，宽高 2:1。
+    if let Some(paper) = s.wallpaper_paper.as_ref() {
+        // 正方形预览：原来按 2:1，主人要求改成方的（2026-11-28）。
+        let pw = m.w as f32 - m.margin * 4.0;
+        let ph = pw;
+        c.fill_round_rect(m.margin * 2.0, y, pw, ph, m.card_radius, t.pal.search);
+        c.paint_picture_in(paper, m.margin * 2.0, y, pw, ph, m.card_radius);
+        y += ph + m.card_gap;
+    }
+    let has = s.wallpaper_file.is_some();
+    let mut rows = vec![
+        Row::new(l.pick(["挑一张图", "挑一張圖", "Choose a picture"]))
+            .icon(PURPLE, Icon::Camera)
+            .trail(Trail::Arrow),
+    ];
+    if has {
+        rows.push(Row::new(l.pick(["去掉壁纸", "去掉壁紙", "No wallpaper"])).icon(SLATE, Icon::Wipe));
+    }
+    let pick = widgets::list(&mut c, t, f, y, &rows);
+    let acts: Vec<Action> = if has {
+        vec![Action::WallpaperPick, Action::WallpaperClear]
+    } else {
+        vec![Action::WallpaperPick]
+    };
+    out.extend(hits(&pick.rows, &acts));
+    y = pick.bottom;
+    if has && wall_open {
+        // 五根滑杆合成一张卡：原来一张一根，一屏全被滑杆吃掉
+        // （2026-11-28 主人要求）。
+        let (tracks, card_bottom) = widgets::slider_stack(
+            &mut c,
+            t,
+            f,
+            y + m.card_gap,
+            &[
+                (Caption::Sun, l.pick(["前景", "前景", "Foreground"]), s.foreground),
+                (Caption::Sun, l.pick(["压暗", "壓暗", "Dim"]), s.wallpaper_dim),
+                (Caption::Sun, l.pick(["缩放", "縮放", "Zoom"]), (s.wallpaper_zoom - 1.0) / 3.0),
+                (Caption::Sun, l.pick(["左右", "左右", "Left / right"]), s.wallpaper_pan_x),
+                (Caption::Sun, l.pick(["上下", "上下", "Up / down"]), s.wallpaper_pan_y),
+            ],
+        );
+        let sliders = [
+            Slider::Foreground,
+            Slider::WallpaperDim,
+            Slider::WallpaperZoom,
+            Slider::WallpaperPanX,
+            Slider::WallpaperPanY,
+        ];
+        for (track, which) in tracks.into_iter().zip(sliders) {
+            out.push(Hit { rect: track, action: Action::Slider(which) });
+        }
+        y = card_bottom;
+    } else if !has {
+        y = widgets::footnote(
+            &mut c,
+            t,
+            f,
+            y,
+            l.pick([
+                "没有壁纸时，背景就是下面那个页面背景色。",
+                "沒有壁紙時，背景就是下面那個頁面背景色。",
+                "With no wallpaper the background is the page colour below.",
+            ]),
+        );
+    }
+
+    // 三组颜色，每组一张卡，**默认收起**：点标题那一行或那条色带展开
+    // （2026-11-28 主人要求可折叠）。
+    let (ar, ag, ab) = crate::app::App::accent_of(s.accent);
+    let (br, bg, bb) = crate::app::App::background_of(s.background, s.theme);
+    let (tr, tg, tb) = crate::app::App::tile_of(s.tile_tint);
+    let groups = vec![
+        (
+            l.pick(["强调色", "強調色", "Accent"]),
+            (ar, ag, ab),
+            [
+                (Slider::AccentRed, l.pick(["红", "紅", "R"]), ar),
+                (Slider::AccentGreen, l.pick(["绿", "綠", "G"]), ag),
+                (Slider::AccentBlue, l.pick(["蓝", "藍", "B"]), ab),
+            ],
+            Action::AccentReset,
+        ),
+        (
+            l.pick(["页面背景", "頁面背景", "Background"]),
+            (br, bg, bb),
+            [
+                (Slider::BackRed, l.pick(["红", "紅", "R"]), br),
+                (Slider::BackGreen, l.pick(["绿", "綠", "G"]), bg),
+                (Slider::BackBlue, l.pick(["蓝", "藍", "B"]), bb),
+            ],
+            Action::BackgroundReset,
+        ),
+        (
+            l.pick(["磁贴底色", "磁貼底色", "Tile background"]),
+            (tr, tg, tb),
+            [
+                (Slider::TileRed, l.pick(["红", "紅", "R"]), tr),
+                (Slider::TileGreen, l.pick(["绿", "綠", "G"]), tg),
+                (Slider::TileBlue, l.pick(["蓝", "藍", "B"]), tb),
+            ],
+            Action::TileReset,
+        ),
+    ];
+
+    for (at, (title, (r, g, b), parts, reset)) in groups.into_iter().enumerate() {
+        let open = s.palette_open.get(at).copied().unwrap_or(false);
+        // 组标题比统一的小标题大一号，右侧一枚展开/折叠的圆钮。
+        let head_y = y + m.card_gap * 2.0;
+        let label_top = head_y + m.section_label_top;
+        c.text(&f.heading, title, m.margin + m.dp(2.0), label_top + m.dp(6.0), m.dp(19.0), t.pal.section, None);
+        fold_row(&mut c, &mut out, at, open, label_top + m.dp(6.0) - m.dp(7.0));
+        y = head_y + m.section_block;
+
+        // 高度按真正画了什么算：收起时只剩一条色带。
+        let sample = Rgba::rgb(r, g, b);
+        let card_w = m.w as f32 - m.margin * 2.0;
+        let pad = m.dp(12.0);
+        let band = m.dp(58.0);
+        let name_h = m.dp(26.0);
+        let slider_h = m.slider_h;
+        let gap = m.dp(6.0);
+        let foot_h = m.dp(36.0);
+        let body_h = if open { (name_h + slider_h + gap) * 3.0 + foot_h } else { 0.0 };
+        let card_h = pad + band + gap + body_h + pad;
+        c.fill_round_rect(m.margin, y, card_w, card_h, m.card_radius, t.pal.card);
+
+        // 顶上一条色带，里面写着 R/G/B 三个数。
+        c.fill_round_rect(m.margin + pad, y + pad, card_w - pad * 2.0, band, m.dp(14.0), sample);
+        let shown = format!("R {r}   G {g}   B {b}");
+        let ink = crate::color::ink_on(sample);
+        c.text(&f.heading, &shown, m.margin + pad + m.dp(12.0), y + pad + band * 0.66, m.dp(19.0), ink, None);
+        if !open {
+            // 收起时整张卡就是那一行：点它展开。
+            out.push(Hit { rect: Rect::new(m.margin, y, card_w, card_h), action: Action::FoldPalette(at) });
+        } else {
+            let mut ry = y + pad + band + gap;
+            for (which, name, value) in parts {
+                c.text(&f.body, &name, m.margin + pad + m.dp(4.0), ry + name_h * 0.72, m.dp(16.0), t.pal.subtitle, None);
+                // 数值靠右，和名字同一行。
+                let text = format!("{value}");
+                let vw = c.text_width(&f.body, &text, m.dp(16.0));
+                c.text(&f.body, &text, m.margin + card_w - pad - m.dp(4.0) - vw, ry + name_h * 0.72, m.dp(16.0), t.pal.text, None);
+                ry += name_h;
+                let track = Rect::new(m.margin + pad, ry, card_w - pad * 2.0, slider_h);
+                widgets::slider(&mut c, t, track.x, track.y, track.w, f32::from(value) / 255.0);
+                out.push(Hit { rect: track, action: Action::Slider(which) });
+                ry += slider_h + gap;
+            }
+            // 卡底一行「用主题自带的」，贴在卡内右下。
+            let text = l.pick(["用主题自带的", "用主題自帶的", "Use the theme's own"]);
+            let tw = c.text_width(&f.body, text, m.dp(15.0));
+            c.text(&f.body, text, m.margin + card_w - pad - tw, ry + m.dp(24.0), m.dp(15.0), t.pal.accent, None);
+            out.push(Hit { rect: Rect::new(m.margin, ry, card_w, foot_h), action: reset });
+        }
+        y += card_h;
+    }
+
+    let note = widgets::footnote(&mut c, t, f, y + m.dp(12.0), l.pick([
+        "主色管开关、按钮、进度条和磁贴那些要点亮的地方；背景色换掉后，卡片和文字会按亮度自动调，保证看得清。磁贴底色只管关着的那些磁贴。",
+        "主色管開關、按鈕、進度條和磁貼那些要點亮的地方；背景色換掉後，卡片和文字會按亮度自動調，保證看得清。磁貼底色只管關著的那些磁貼。",
+        "The accent colours the switches, buttons, sliders and tiles that light up; change the background and the cards and text follow its lightness so they stay readable. The tile background only affects tiles that are off.",
+    ]));
+    Frame::new(t, fit(c, t, note), out, l.pick(["主题颜色", "主題顏色", "Colours"]), m.content_top)
+}
