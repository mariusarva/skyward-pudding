+/// 挑一张壁纸：目录里点一张图就用它（2026-11-28）。
+pub fn wallpaper_browse(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let m = &t.m;
+    let mut c = long_page(cx);
+    let mut out = Vec::new();
+    let mut y = m.content_top;
+
+    // 内置那四张已经去掉：这一页顶上就是「挑一张」，下面一格一张缩略图；
+    // 「壁纸文件夹」那一行挪到缩略图后面去（2026-11-28 主人要求挑图在顶部）。
+    y = widgets::section_first(&mut c, t, f, y, l.pick(["挑一张", "挑一張", "Pick one"]));
+    if s.wallpaper_dir.is_empty() {
+        y = widgets::footnote(&mut c, t, f, y, l.pick([
+            "还没设壁纸文件夹。点上面那一行填一个路径，往里丢 jpg、png 就能选。",
+            "還沒設壁紙資料夾。點上面那一行填一個路徑，往裡丟 jpg、png 就能選。",
+            "No wallpaper folder yet. Tap the row above to set one, then put jpg or png files in it.",
+        ]));
+    } else if let Some(why) = &s.wallpaper_dir_note {
+        y = widgets::footnote(&mut c, t, f, y, why);
+    } else if s.wallpaper_dir_files.is_empty() {
+        y = widgets::footnote(&mut c, t, f, y, l.pick([
+            "这个文件夹里还没找到图。把 jpg、png 丢进去，退出去再进来就看得见。",
+            "這個資料夾裡還沒找到圖。把 jpg、png 丟進去，退出去再進來就看得到。",
+            "No pictures in that folder yet. Put some jpg or png files in it and open this page again.",
+        ]));
+    } else {
+        let columns = 2usize;
+        let gap = m.dp(10.0);
+        let narrow = (m.w as f32 - m.margin * 2.0 - gap * (columns as f32 - 1.0)) / columns as f32;
+        // 一行只摆得下一张时（总共一张、或者剩最后一张），它自己就占满一屏宽
+        // 的大预览，并且居中 —— 缩在左上角半格看着像没画出来（2026-11-28）。
+        let wide = m.w as f32 - m.margin * 4.0;
+        let name_h = m.dp(20.0);
+        // 缩略图也是正方形（2026-11-28 主人要求）。
+        // 一页最多摆 8 张：再多也没人愿意在这上面翻，而且每张都要解一次
+        // 缩略图（2026-11-28）。
+        let shown = s.wallpaper_dir_files.len().min(8);
+        let mut row = 0usize;
+        while row * columns < shown {
+            let in_row = (shown - row * columns).min(columns);
+            let cell_w = if in_row == 1 { wide } else { narrow };
+            let cell_h = cell_w;
+            let row_w = in_row as f32 * cell_w + (in_row as f32 - 1.0) * gap;
+            let row_x = (m.w as f32 - row_w) / 2.0;
+            for column in 0..in_row {
+                let at = row * columns + column;
+                let path = &s.wallpaper_dir_files[at];
+                let x = row_x + column as f32 * (cell_w + gap);
+                let cy = y;
+                c.fill_round_rect(x, cy, cell_w, cell_h, m.card_radius, t.pal.search);
+                if let Some(paper) = s.wallpaper_thumbs.get(&at) {
+                    c.paint_picture_in(paper, x, cy, cell_w, cell_h, m.card_radius);
+                }
+                // 文件名压在缩略图下沿，认得出是哪张就够。
+                let name = path.rsplit('/').next().unwrap_or(path);
+                let shown_name = if name.chars().count() > 22 {
+                    format!("{}…", name.chars().take(22).collect::<String>())
+                } else {
+                    name.to_string()
+                };
+                let name_w = c.text_width(&f.body, &shown_name, m.dp(11.0));
+                c.text_top(&f.body, &shown_name, x + (cell_w - name_w) / 2.0, cy + cell_h + m.dp(4.0), m.dp(11.0), t.pal.subtitle, Some(cell_w));
+                let chosen = s.wallpaper_file.as_deref() == Some(path.as_str());
+                if chosen {
+                    c.stroke_round_rect(x, cy, cell_w, cell_h, m.card_radius, m.dp(3.0), t.pal.accent);
+                    let d = m.dp(24.0);
+                    let bx = x + cell_w - d * 0.55;
+                    let by = cy + d * 0.55;
+                    c.fill_circle(bx, by, d / 2.0, t.pal.accent);
+                    let k = d * 0.5;
+                    let ink = Rgba::rgb(255, 255, 255);
+                    c.line(bx - k * 0.42, by + k * 0.02, bx - k * 0.1, by + k * 0.32, m.dp(2.2), ink);
+                    c.line(bx - k * 0.1, by + k * 0.32, bx + k * 0.44, by - k * 0.3, m.dp(2.2), ink);
+                }
+                out.push(Hit {
+                    rect: Rect::new(x, cy, cell_w, cell_h + name_h),
+                    action: Action::WallpaperFile(at),
+                });
+            }
+            y += cell_h + name_h + gap;
+            row += 1;
+        }
+        if s.wallpaper_dir_files.len() > shown {
+            y = widgets::footnote(&mut c, t, f, y + m.dp(6.0), l.pick([
+                "这里只摆前 8 张，其余的换个文件夹放。",
+                "這裡只擺前 8 張，其餘的換個資料夾放。",
+                "Only the first eight show here; put the rest in another folder.",
+            ]));
+        }
+    }
+
+    // 图都列完了才说文件夹在哪：这一页第一眼要看到的是图。
+    y = widgets::section(&mut c, t, f, y + m.card_gap * 2.0, l.pick(["壁纸文件夹", "壁紙資料夾", "Wallpaper folder"]));
+    let folder = widgets::list(&mut c, t, f, y, &[Row::new(l.pick(["壁纸文件夹", "壁紙資料夾", "Wallpaper folder"]))
+        .icon(PURPLE, Icon::Folder)
+        .trail(Trail::Value(if s.wallpaper_dir.is_empty() { l.pick(["没设", "沒設", "not set"]) } else { &s.wallpaper_dir }))]);
+    out.push(Hit { rect: folder.rows[0], action: Action::EditWallpaperDir });
+    y = folder.bottom;
+
+    let note = widgets::footnote(&mut c, t, f, y + m.card_gap * 2.0, l.pick([
+        "点一张就换上；压暗、缩放、左右上下和「前景」都在「主题颜色」那一页调。",
+        "點一張就換上；壓暗、縮放、左右上下和「前景」都在「主題顏色」那一頁調。",
+        "Tap one to use it; dim, zoom, position and foreground are set on the colours page.",
+    ]));
+    Frame::new(t, fit(c, t, note), out, l.pick(["挑一张壁纸", "挑一張壁紙", "Choose a wallpaper"]), m.content_top)
+}
