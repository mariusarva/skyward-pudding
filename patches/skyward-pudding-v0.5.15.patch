+        app.refresh();
+        let track = app.frame(&f, &i).hits.iter().find(|h| h.action == Action::Slider(Slider::AccentRed)).unwrap().rect;
+        let y = track.centre().1 - app.top().1;
+        app.touch(Touch::Down(track.x + track.w * 0.3, y), &f, 1000);
+        assert_eq!(app.deadline(1000), Some(0), "按住滑杆时立刻要下一帧");
+        app.touch(Touch::Move(track.x + track.w * 0.6, y), &f, 1016);
