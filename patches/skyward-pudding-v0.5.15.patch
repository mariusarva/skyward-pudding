+++ b/crates/skyward/src/listing.rs
@@ -0,0 +1,103 @@
+//! 在后台线程里列一个目录：/sdcard 在 FUSE 上，逐条 stat 慢得能把界面拖死，
+//! 挑壁纸、挑布局文件时改成后台读、读完再交给页面（2026-11-28）。
+
+use anyhow::Result;
+use skyward_sys::worker::{Teller, Worker};
+use skyward_ui::app::FileRow;
+use std::path::PathBuf;
+
+/// 后台线程报回来的事。
+pub enum Event {
+    /// 这一层读好了，或者读不了。
+    Listed { folder: PathBuf, rows: Result<Vec<FileRow>, String> },
+}
+
+pub struct Listing {
+    worker: Worker<Event>,
+}
+
+impl Listing {
+    /// 起一个线程去读 `folder`。
+    pub fn start(folder: PathBuf) -> Result<Listing> {
+        let at = folder.clone();
+        let worker = Worker::start("listing", move |tell: Teller<Event>| {
+            let began = std::time::Instant::now();
+            let _ = skyward_sys::kmsg(&format!("listing: reading {}", at.display()));
+            let rows = crate::ui::read_folder_picker(&at).map_err(|e| format!("{e:#}"));
+            let count = rows.as_ref().map(|r| r.len()).unwrap_or(0);
+            let _ = skyward_sys::kmsg(&format!(
+                "listing: {} gave {count} entries in {} ms",
+                at.display(),
+                began.elapsed().as_millis()
+            ));
+            tell.tell(Event::Listed { folder: at, rows });
+        })?;
