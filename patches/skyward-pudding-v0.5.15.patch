+    #[test]
+    fn a_finger_on_a_slider_asks_for_a_frame_every_time() {
+        let (f, i) = (fonts(), info());
+        let mut app = App::new(Screen::Accent, W, H, PPD);
+        // 三组颜色卡默认是收起的，这些用例要拨滑杆，先全展开（2026-11-28）。
