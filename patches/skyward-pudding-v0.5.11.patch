diff --git a/crates/skyward/src/wlanmem.rs b/crates/skyward/src/wlanmem.rs
new file mode 100644
index 0000000..1018a19
--- /dev/null
+++ b/crates/skyward/src/wlanmem.rs
@@ -0,0 +1,320 @@
+//! The WLANs a user chose to have kept: whether the radio is opened as the
+//! recovery starts, whether the passwords of the networks joined are kept,
+//! and those networks with their passwords.
+//!
+//! 一个文件里记多张网：公司一张、家里一张，开机（或换地方）时按记住的先后
+//! 挨个试，哪张在范围内就连哪张。
+//!
+//! Kept beside the recovery's own settings, readable by root alone. Turning
+//! the passwords off leaves the networks already kept as they are, and a
+//! factory reset takes them away.
+
+use anyhow::{Context, Result};
+use skyward_net::supplicant::Security;
+use std::os::unix::fs::PermissionsExt;
+use std::path::Path;
+
+/// The partition the file is on, made writable for as long as a write takes.
+const METADATA: &str = "/metadata";
+
+/// Where it is kept: beside the recovery's own settings.
+pub const FILE: &str = "/metadata/skyward/wlan";
+
+/// A network kept, with the password it was joined with and the kind of
+/// protection it has: joining it again as soon as the radio is up needs
+/// both, without waiting for a scan to say what it is.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Saved {
+    pub ssid: Vec<u8>,
+    pub password: String,
+    pub security: Security,
+}
+
+/// What the file holds.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Kept {
+    /// Open the WLAN as the recovery starts.
+    pub auto: bool,
+    /// Keep the passwords of the networks joined.
+    pub keep: bool,
+    /// 记住的网，**最近用过的在前**：开机先试它，试不通再往后。
+    pub networks: Vec<Saved>,
+}
+
+/// 最多记这么多张，超了丢最久没用的那张。
+pub const MOST: usize = 8;
+
+/// 第一次开机没有这个文件时：默认记住密码。
+impl Default for Kept {
+    fn default() -> Self {
+        Kept { auto: false, keep: true, networks: Vec::new() }
+    }
+}
+
+/// What is kept, as the file holds it.
+pub fn read() -> Kept {
+    with_metadata(read_unmounted)
+}
+
+/// Read it with /metadata mounted for the moment it takes: the pages are built
+/// before the recovery mounts it, and a file read then is a file not found.
+fn with_metadata<T>(work: impl FnOnce() -> T) -> T {
+    let at = std::path::Path::new("/metadata");
+    let mounted = skyward_block::mount::is_mount_point(at).unwrap_or(false);
+    if !mounted
+        && skyward_block::mount::mount_ro(&std::path::Path::new(skyward_block::BY_NAME).join("metadata"), at).is_err()
+    {
+        return work();
+    }
+    let done = work();
+    if !mounted {
+        let _ = skyward_block::mount::umount(at);
+    }
+    done
+}
+
+fn read_unmounted() -> Kept {
+    let text = match std::fs::read_to_string(FILE) {
+        Ok(text) => text,
+        Err(_) => return Kept::default(),
+    };
+    let mut kept = Kept::default();
+    // 每一节是一张网；第一节另有 auto / keep。老文件没有 `[net]` 头，
+    // 那张网就写在第一节里，照样读得出来。
+    let mut sections: Vec<Vec<&str>> = vec![Vec::new()];
+    for line in text.lines() {
+        if line.trim() == "[net]" {
+            sections.push(Vec::new());
+            continue;
+        }
+        if let Some(last) = sections.last_mut() {
+            last.push(line);
+        }
+    }
+    for (index, lines) in sections.iter().enumerate() {
+        let mut ssid = None;
+        let mut password = None;
+        let mut security = None;
+        for line in lines {
+            let Some((key, value)) = line.split_once('=') else {
+                continue;
+            };
+            let value = value.trim();
+            match key.trim() {
+                "auto" if index == 0 => kept.auto = value == "1",
+                "keep" if index == 0 => kept.keep = value == "1",
+                "ssid" => ssid = unhex(value),
+                // 新格式：密码是十六进制，`=`、空格都不会把文件写坏。
+                "pw" => password = unhex(value).and_then(|bytes| String::from_utf8(bytes).ok()),
+                // 老格式：密码就是原文。
+                "password" => password = Some(value.to_string()),
+                "security" => security = Some(security_of(value)),
+                _ => {}
+            }
+        }
+        if let (Some(ssid), Some(password)) = (ssid, password)
+            && !ssid.is_empty()
+            && !password.is_empty()
+        {
+            // 老文件没记保护方式：PSK 与 SAE 都给，两种网都能连。
+            kept.networks.push(Saved { ssid, password, security: security.unwrap_or(Security::PskSae) });
+        }
+    }
+    // 名单不再跟着「记住密码」的开关走：开关关掉只是不再记新的。
+    kept.networks.truncate(MOST);
+    kept
+}
+
+/// Do `work` with the partition writable, and read-only again afterwards.
+fn writable<T>(work: impl FnOnce() -> Result<T>) -> Result<T> {
+    let at = Path::new(METADATA);
+    let mounted = skyward_block::mount::is_mount_point(at)?;
+    if mounted {
+        skyward_block::mount::remount_writable(at, true).context("make /metadata writable")?;
+    }
+    let done = work();
+    if mounted {
+        let _ = skyward_block::mount::remount_writable(at, false);
+    }
+    done
+}
+
+fn store(text: &str) -> Result<()> {
+    writable(|| {
+        let at = Path::new(FILE);
+        if let Some(dir) = at.parent() {
+            std::fs::create_dir_all(dir).with_context(|| format!("make {}", dir.display()))?;
+        }
+        std::fs::write(at, text).with_context(|| format!("write {}", at.display()))?;
+        std::fs::set_permissions(at, std::fs::Permissions::from_mode(0o600))
+            .with_context(|| format!("keep {} to root alone", at.display()))?;
+        Ok(())
+    })
+}
+
+fn render(kept: &Kept) -> String {
+    let mut text = format!("auto={}\nkeep={}\n", u8::from(kept.auto), u8::from(kept.keep));
+    // `keep` 只管「以后连上的还记不记」，不再拿它挡着写名单：以前一到 keep=0
+    // 就只写两行开关，文件一存，记住的那几张网全没了。要删某一张，只有 `forget`。
+    for saved in kept.networks.iter().take(MOST) {
+        text.push_str("[net]\n");
+        text.push_str(&format!("ssid={}\n", hex(&saved.ssid)));
+        text.push_str(&format!("pw={}\n", hex(saved.password.as_bytes())));
+        text.push_str(&format!("security={}\n", security_code(saved.security)));
+    }
+    text
+}
+
+/// Set whether the WLAN opens as the recovery starts, leaving the rest as it
+/// was.
+pub fn set_auto(on: bool) -> Result<()> {
+    let mut kept = read();
+    kept.auto = on;
+    store(&render(&kept))
+}
+
+/// Set whether a network joined from now on is kept. Turning it off leaves the
+/// ones already kept as they are.
+pub fn set_keep(on: bool) -> Result<()> {
+    let mut kept = read();
+    kept.keep = on;
+    store(&render(&kept))
+}
+
+/// Keep `ssid`, the password it was joined with and the kind of protection it
+/// has. 同一张网再存一次就挪到最前面 —— 开机先试它。
+pub fn save(ssid: &[u8], password: &str, security: Security) -> Result<()> {
+    let mut kept = read();
+    kept.keep = true;
+    kept.networks.retain(|saved| saved.ssid != ssid);
+    kept.networks.insert(0, Saved { ssid: ssid.to_vec(), password: password.to_string(), security });
+    kept.networks.truncate(MOST);
+    store(&render(&kept))
+}
+
+/// Forget `ssid` alone: another network's password is not this one's business.
+pub fn forget(ssid: &[u8]) -> Result<()> {
+    let mut kept = read();
+    kept.networks.retain(|saved| saved.ssid != ssid);
+    store(&render(&kept))
+}
+
+/// How the kind of protection is written in the file.
+fn security_code(security: Security) -> &'static str {
+    match security {
+        Security::Open => "open",
+        Security::Owe => "owe",
+        Security::Wep => "wep",
+        Security::Psk => "psk",
+        Security::Sae => "sae",
+        Security::PskSae => "psksae",
+        Security::Enterprise => "enterprise",
+    }
+}
+
+/// What the file's word for it means.
+fn security_of(code: &str) -> Security {
+    match code {
+        "open" => Security::Open,
+        "owe" => Security::Owe,
+        "wep" => Security::Wep,
+        "sae" => Security::Sae,
+        "psksae" => Security::PskSae,
+        "enterprise" => Security::Enterprise,
+        _ => Security::Psk,
+    }
+}
+
+fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+fn unhex(text: &str) -> Option<Vec<u8>> {
+    if text.len() % 2 != 0 {
+        return None;
+    }
+    (0..text.len())
+        .step_by(2)
+        .map(|i| u8::from_str_radix(text.get(i..i + 2)?, 16).ok())
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// 按文件的写法切开：第一个 `[net]` 之前是 auto / keep。
+    fn sections(text: &str) -> Vec<Vec<&str>> {
+        let mut out: Vec<Vec<&str>> = vec![Vec::new()];
+        for line in text.lines() {
+            if line.trim() == "[net]" {
+                out.push(Vec::new());
+            } else if let Some(last) = out.last_mut() {
+                last.push(line);
+            }
+        }
+        out
+    }
+
+    #[test]
+    fn a_name_goes_round_the_file_as_bytes() {
+        assert_eq!(unhex(&hex("Skyward客厅".as_bytes())).as_deref(), Some("Skyward客厅".as_bytes()));
+    }
+
+    #[test]
+    fn a_password_keeps_what_it_holds() {
+        assert_eq!(unhex(&hex(b"pa ss=word")), Some(b"pa ss=word".to_vec()));
+    }
+
+    #[test]
+    fn half_a_byte_is_no_name() {
+        assert_eq!(unhex("abc"), None);
+    }
+
+    #[test]
+    fn what_is_written_is_a_setting_and_one_network() {
+        let kept = Kept {
+            auto: true,
+            keep: true,
+            networks: vec![Saved { ssid: b"Sarva5".to_vec(), password: "p=w d".into(), security: Security::PskSae }],
+        };
+        let text = render(&kept);
+        assert_eq!(text, "auto=1\nkeep=1\n[net]\nssid=536172766135\npw=703d772064\nsecurity=psksae\n");
+        assert_eq!(sections(&text).len(), 2);
+    }
+
+    #[test]
+    fn a_second_network_is_kept_beside_the_first_newest_first() {
+        let kept = Kept {
+            auto: true,
+            keep: true,
+            networks: vec![
+                Saved { ssid: b"home".to_vec(), password: "h".into(), security: Security::Psk },
+                Saved { ssid: b"office".to_vec(), password: "o".into(), security: Security::Sae },
+            ],
+        };
+        let text = render(&kept);
+        assert_eq!(sections(&text).len(), 3, "两张网各一节");
+        assert!(text.find("ssid=686f6d65").unwrap() < text.find("ssid=6f6666696365").unwrap());
+    }
+
+    #[test]
+    fn a_network_is_still_written_when_the_setting_is_off() {
+        let kept = Kept {
+            auto: true,
+            keep: false,
+            networks: vec![Saved { ssid: b"x".to_vec(), password: "y".into(), security: Security::Psk }],
+        };
+        let text = render(&kept);
+        assert!(text.starts_with("auto=1\nkeep=0\n"), "开关照实写");
+        assert!(text.contains("ssid=78"), "网络也照写");
+        assert_eq!(sections(&text).len(), 1, "一张网一节");
+    }
+
+    #[test]
+    fn the_file_written_for_one_network_still_reads_as_one() {
+        let text = "auto=1\nkeep=1\nssid=536172766135\npassword=p=w d\nsecurity=psksae\n";
+        assert_eq!(sections(text).len(), 1, "老文件没有 [net] 头");
+        assert_eq!(unhex("536172766135").as_deref(), Some(b"Sarva5".as_slice()));
+    }
+}
diff --git a/devices/bixi.toml b/devices/bixi.toml
new file mode 100644
index 0000000..b1733c5
--- /dev/null
+++ b/devices/bixi.toml
@@ -0,0 +1,276 @@
+[device]
+codename = "bixi"
+brand = "Xiaomi"
+model = "Xiaomi MIX Flip 2"
+ab = true
+soc = { hans = "骁龙®8至尊版移动平台", hant = "Snapdragon® 8 Elite 行動平台", en = "Snapdragon® 8 Elite Mobile Platform" }
+os_version_prop = "ro.mi.os.version.incremental"
+
+[display]
+width = 1224
+height = 2912
+# 密度取自小米自己的属性：/odm/etc/build.prop 里
+# ro.miui.density.secondaryppi=460（"#xiaomi app autodensity" 一组），
+# 而两块屏按分辨率算出来都是 460 ppi（内屏 1224×2912 / 6.86" = 460.5），
+# 所以 460 是这块屏的原始密度，不是取整出来的估值。
+density = 460
+diagonal = 6.86
+# 圆角取自系统的 DevicesAndroidOverlay（/product/overlay/
+# DevicesAndroidOverlay.apk）：rounded_corner_radius = 134px，
+# 同一份配置里 status_bar_height = 146px；另一份基础配置是 130px。
+corner_radius = 134
+cover_display = true
+
+[modules]
+sources = ["vendor_boot", "vendor_dlkm", "vendor", "system_dlkm"]
+# 内屏触摸：Synaptics TCM（SPI，DT 节点 synaptics_tcm@0 / compatible
+# "synaptics,tcm-spi"），驱动 synaptics_tcm2.ko，外面套一层小米自己的
+# xiaomi_touch.ko（/sys/class/touch/touch_dev 就是它建的），依赖由
+# vendor_dlkm 的 modules.dep 自动补齐。
+# mitee_dlkm：小米 TEE 的 GlobalPlatform client 驱动，weaver 要开它建出来的
+# 节点才能摸到安全芯片；原厂 recovery 不加载它。
+# nxp-nci：NXP 的 NFC/eSE 驱动，建出 /dev/nq-nci；secure_element HAL 要靠它
+# 给 eSE 上电并取 ATR（eseGetVendorId），没有节点只会报 Unknown eSE HW。
+# goodix_core：外屏（合盖后那块 1208x1392）的触摸，Goodix GT9916K 走 I2C，
+# 固件在 /odm/firmware/goodix_firmware_bixi.bin；它建出的输入设备是
+# virtual 节点（input8 / event8），属性里没有 DIRECT，触摸映射要用它自己的
+# ABS_MT 范围换算到 1208x1392 的页面。
+# 但它不能在这里开机加载：内屏还亮着时把它装进去，随后内屏一灭，驱动就把
+# 控制器当成自己该挂起，切成手势模式，之后只上报手势、不再出坐标（合盖后
+# event8 恒 0 事件，dmesg 只有 DebugInfo 包）。所以由界面在合盖、外屏点亮的
+# 那一刻自己 insmod，开盖再卸载（见 ui.rs 的 load_cover_touch）。
+load = ["synaptics_tcm2", "mitee_dlkm", "nxp-nci"]
+
+# 驱动复位后控制器只上报 raw 帧，要靠小米的 touch 算法（/odm/lib64 里的
+# libtouchreport.so）才变成触摸点；recovery 里跑不了这套，所以让驱动
+# 让控制器自己报坐标。
+[touch]
+writes = [{ path = "/sys/class/touch/touch_dev/enable_touch_raw", value = "0" }]
+
+# modem 分区放着 WLAN 固件和 secure world 要用的镜像，原厂 recovery 不挂，
+# 这里挂到 /vendor/firmware_mnt。
+[firmware]
+partition = "modem"
+
+# persist 分区是 secure world 自己用的（keymint 的不可回滚密钥、WLAN MAC 等）。
+[partitions]
+mounted = ["persist"]
+
+# 原厂 recovery 的 logd 缺 libsysutils / libcap，会起来就退。
+[logd]
+libraries = ["/mnt/system/system/lib64/libsysutils.so", "/mnt/system/system/lib64/libcap.so"]
+
+# 手机自己的 init 在系统起完后跑的脚本，把 CPU 交给 WALT 并让空闲核降频。
+[[service]]
+path = "/vendor/bin/sh"
+args = ["/vendor/bin/init.kernel.post_boot.sh"]
+libraries = ["/system/lib64", "/vendor/lib64"]
+oneshot = true
+user = "root"
+groups = ["root", "system", "wakelock", "graphics"]
+
+# secure world 回调 Android 用的监听器，keymint 少了它用不了任何密钥。
+[[service]]
+path = "/vendor/bin/qseecomd"
+libraries = ["/system/lib64", "/vendor/lib64"]
+ready_property = "vendor.sys.listeners.registered"
+user = "root"
+groups = ["root", "drmrpc"]
+
+# 访问 secure world 里那些 TA 的中间服务。手机自己的 init 让它以 system 身份
+# 跑在 hal 类里；没有它，keymint / gatekeeper 找不到要调用的 TA 加载器。
+[[service]]
+path = "/vendor/bin/hw/vendor.qti.hardware.qseecom@1.0-service"
+libraries = ["/system/lib64", "/vendor/lib64", "/vendor/lib64/hw"]
+ready_service = "vendor.qti.hardware.qseecom.IQSEECom/default"
+user = "system"
+groups = ["system", "drmrpc"]
+
+# 小米自己的安全服务（qwesd@2.0）。TEE 在它把密钥备好之前不回答任何请求，
+# keymint 与 weaver 都要通过它的 socket 说话。手机上是 class late_start。
+[[service]]
+path = "/vendor/bin/qwesd"
+libraries = ["/system/lib64", "/vendor/lib64"]
+user = "system"
+groups = ["system"]
+
+# ssgtzd：把 modem 分区里的 TA（gpqese、weaver）装载给 secure world。
+# 手机上是 init 替它建好 /dev/socket/ssgtzd 与 ssgtzd_opener 两个 socket，
+# recovery 的 init 不建；它自己会 bind，只要 /dev/socket 可写（extra 里
+# 有一条 early-init 把它放开）。weaver 的请求全靠这两个 socket 转进安全世界。
+[[service]]
+path = "/vendor/bin/ssgtzd"
+libraries = ["/system/lib64", "/vendor/lib64"]
+user = "system"
+# vendor_ssgtzd 就是 2912（oem_2912 的别名），/vendor/etc/group 里有。
+groups = ["system", "vendor_ssgtzd", "wakelock"]
+capabilities = ["WAKE_ALARM", "BLOCK_SUSPEND"]
+
+# KeyMint：唯一能用硬件包裹密钥的服务，也管安全时钟和共享密钥。
+# 库顺序照参照机器：recovery 自带的 lib64 在最前，真实 system 的 lib64 与
+# bootstrap（真实 libdl_android 所在）垫在最后。
+[[service]]
+path = "/vendor/bin/hw/android.hardware.security.keymint-service-qti"
+libraries = ["/system/lib64", "/vendor/lib64", "/mnt/system/system/lib64", "/mnt/system/system/lib64/bootstrap"]
+ready_service = "android.hardware.security.keymint.IKeyMintDevice/default"
+registers = [
+    "android.hardware.security.keymint.IRemotelyProvisionedComponent/default",
+    "android.hardware.security.secureclock.ISecureClock/default",
+    "android.hardware.security.sharedsecret.ISharedSecret/default",
+]
+# 手机自己的 init 让它以 system 跑，照抄。
+user = "system"
+groups = ["system", "drmrpc"]
+
+# 安全芯片（eSE）服务：把芯片里的 applet 暴露成 Android 的 OMAPI，weaver 就
+# 通过它摸到密钥槽。手机上是 system 身份、属于 nfc 组。它不被等待，晚起也不堵后面。
+[[service]]
+path = "/vendor/bin/hw/android.hardware.secure_element-service.qti"
+libraries = ["/system/lib64", "/vendor/lib64", "/vendor/lib64/hw", "/mnt/system/system/lib64", "/mnt/system/system/lib64/bootstrap"]
+registers = ["android.hardware.secure_element.ISecureElement/eSE1"]
+user = "system"
+groups = ["system"]
+
+# OMAPI：weaver 问安全芯片要槽位时不走 ssgtzd，而是走 Android 的
+# android.se.omapi.ISecureElementService —— 正式系统里这个服务由 Java 框架的
+# com.android.se 提供，recovery 没有框架，所以必须自己起一个。用 OrangeFox
+# 随包带的 se_omapi（external/se_omapi），它只依赖 libbinder_ndk 与两个 AIDL
+# 库，比 17 Pro 那整只 8.6MB 的 recovery 二进制省事。
+[[service]]
+path = "/system/bin/se_omapi"
+libraries = ["/system/lib64", "/vendor/lib64", "/odm/lib64", "/mnt/system/system/lib64", "/mnt/system/system/lib64/bootstrap"]
+ready_service = "android.se.omapi.ISecureElementService/default"
+registers = ["android.se.omapi.ISecureElementService/default"]
+user = "root"
+groups = ["root"]
+
+# Weaver：每个用户的密钥都绑在安全芯片的一个槽位上，有没有锁屏都要靠它解封。
+# bixi 的这个程序由小米装在 odm 分区，手机 init 里 user/group 都是
+# vendor_nxp_weaver 并带 WAKE_ALARM；recovery 的账户表里没有这个名字，
+# 用 system 顶上。它要加载 odm 与 vendor 的库，两者都会去要真实 system 的
+# libvndksupport 与 libdl_android，所以真实 system 的库排最后。
+[[service]]
+path = "/odm/bin/hw/android.hardware.weaver-service.nxp-qti"
+libraries = ["/odm/lib64", "/system/lib64", "/vendor/lib64", "/mnt/system/system/lib64", "/mnt/system/system/lib64/bootstrap"]
+ready_service = "android.hardware.weaver.IWeaver/default"
+registers = ["android.hardware.weaver.IWeaver/default"]
+# bixi 的 odm 清单里 weaver 还是老写法（<interface><name>/<instance>），
+# Skyward 只认 <fqname>IWeaver/default</fqname>，于是这个文件不会被选中、
+# servicemanager 也就拒绝注册。这里给它一份现代写法的描述。
+description = "/system/etc/vintf/weaver-nxp.xml"
+# 参照 songyuan（同为骁龙 + NXP 方案）：weaver 用 root。它要开 TEE 的
+# /dev/teepriv0 这类 root 专属节点，system 身份下请求送不到安全世界。
+user = "root"
+groups = ["root"]
+capabilities = ["WAKE_ALARM"]
+
+# 身份凭证校验（gatekeeper）：锁屏密码、图案、多用户都靠它在安全世界里验。
+# 原厂 rc 里这个服务是 disabled，只有 vendor.gatekeeper.is_security_level_spu=0
+# 时才 enable —— 也就是不让它把安全处理单元（SPU）放进调用路径。
+#
+# 实测（0.40.00）：属性打上以后程序能起来，但两条都过不去，程序自己在
+# `Check failed: status == STATUS_OK`（KeymasterUtils::spu_init）处 abort，
+# 一秒一次被重启；同时 servicemanager 报
+#   Could not find android.hardware.gatekeeper.IGatekeeper/default in the VINTF manifest
+# 也就是说 recovery 里既没有它要的 SPU 服务，也没在 VINTF 里声明这个实例。
+# 目前的密码解锁走的是 weaver（Bound::Weaver），不经过 gatekeeper，所以不受影响；
+# 要让「图案 / 第二用户」可用，得先解决上面两条，届时再把这两段放开。
+#
+# 结论（0.44.00）：不在 recovery 里继续追这个服务。缺的两样 —— SPU 服务与 VINTF
+# 声明 —— 都是系统侧的东西，recovery 的 ld.config 只有 default 命名空间，补不出
+# 一个能用的 spu_init；「图案解锁 / 第二用户」因此是本 recovery 的已知限制，
+# 页面上的解锁仍只按密码与 weaver 走。
+#
+# [[service]]
+# path = "/vendor/bin/sh"
+# args = ["-c", "setprop vendor.gatekeeper.disable_spu true; setprop vendor.gatekeeper.is_security_level_spu 0"]
+# libraries = ["/system/lib64", "/vendor/lib64"]
+# oneshot = true
+# user = "root"
+# groups = ["root", "system"]
+#
+# [[service]]
+# path = "/vendor/bin/hw/android.hardware.gatekeeper-service-qti"
+# libraries = ["/system/lib64", "/vendor/lib64", "/vendor/lib64/hw", "/mnt/system/system/lib64", "/mnt/system/system/lib64/bootstrap"]
+# ready_service = "android.hardware.gatekeeper.IGatekeeper/default"
+# registers = ["android.hardware.gatekeeper.IGatekeeper/default"]
+# user = "system"
+# groups = ["system"]
+
+# boot control：读写 A/B slot 的选择，放最后，前面的起不来也还能用。
+[[service]]
+path = "/vendor/bin/hw/android.hardware.boot-service.qti"
+libraries = ["/system/lib64", "/vendor/lib64"]
+ready_service = "android.hardware.boot.IBootControl/default"
+user = "root"
+groups = ["root"]
+
+# WLAN：Qualcomm Peach（qca_cld3_peach_v2）走 cnss2，cfg80211 需要内核自带的
+# rfkill（system_dlkm 里，系统会先加载，recovery 不带）。
+[wlan]
+modules = ["rfkill", "qca_cld3_peach_v2"]
+writes = [{ path = "/sys/kernel/cnss/fs_ready", value = "1" }]
+release = [{ path = "/sys/kernel/cnss/fs_ready", value = "0" }]
+# cnss2 探针时向内核固件加载器要 wlan/qca_cld/peach_v2/WCNSS_qcom_cfg.ini，
+# 而它只存在于 /vendor/etc/wifi 下；不摆到 /etc/firmware 就会
+# "Failed to probe host driver, err = -1"，wlan0 永远不出现。
+firmware = [
+    { name = "wlan/qca_cld/peach_v2/WCNSS_qcom_cfg.ini", path = "/vendor/etc/wifi/peach_v2/WCNSS_qcom_cfg.ini" },
+    { name = "wlan/qca_cld/peach_v2/wlan_mac.bin", path = "/mnt/vendor/persist/wlan/wlan_mac.bin", optional = true },
+]
+interface = "wlan0"
+supplicant = "/vendor/bin/hw/wpa_supplicant"
+libraries = ["/system/lib64", "/vendor/lib64"]
+service = "android.hardware.wifi.supplicant.ISupplicant/default"
+probe = "http://connect.rom.miui.com/generate_204"
+# 开机把无线网卡和 supplicant 起来，但要等 /data 解密完成：连过的网络存在
+# /data 里，分区没开时读不到，所以真正的「自动连上」发生在你输完密码之后。
+auto = true
+
+# 上次连的网记在 /data/misc/wifi/skyward/joined（0600、chown wifi、明文 PSK，
+# 与安卓自带 WifiConfigStore 同口径）。不想要这个文件就改成 false：连接只在
+# 内存里，密码不落盘，代价是每次开机都要手动连一次网。
+remember = true
+
+[update]
+server = "https://update.miui.com/updates/miotaV3.php"
+
+# 做这个 recovery 所基于的原厂版本：中国版 OS4.0.0.11（Android 17），小米自家下载服务器上的
+# 完整包（9.35 GB）里就有这块机子的 recovery 分区。地址已 HEAD 过，返回 200。
+[stock]
+version = "OS4.0.0.11.XOHCNXM"
+package = "https://bkt-sgp-miui-ota-update-alisgp.oss-ap-southeast-1.aliyuncs.com/OS4.0.0.11.XOHCNXM/bixi-ota_full-OS4.0.0.11.XOHCNXM-user-17.0-a2f3e2774c.zip"
+recovery = "cad33d37009a7c9a16779571e32dcd9c71de80d921dd7d3ea913c058210f0429"
+
+# qcom-hv-haptics，X1 线性马达，手机自己量到的谐振 170 Hz
+# （ro.odm.mm.vibrator.resonant_frequency=170）。
+[haptics]
+resonance = "/sys/class/qcom-haptics/lra_frequency_hz"
+strength = { lightest = 0.25, strongest = 0.75 }
+
+[backup]
+efs = ["modemst1", "modemst2", "fsg", "fsc", "persist"]
+data_skipped = [
+    "vendor/tzstorage",
+    "vendor/qtee",
+    "vendor/mitee",
+    "vendor/goodix",
+    "vendor/fpc",
+    "vendor/fingerprint",
+    "vendor/fpdata",
+    "vendor/misc/mi_fp",
+    "vendor/secure_element",
+]
+
+[wipe]
+logs = [
+    "/data/miuilog",
+    "/data/vendor/diag",
+    "/data/vendor/bsplog",
+    "/data/vendor/log",
+    "/data/vendor/ramdump",
+    "/data/vendor/ramdump_ssr",
+    "/data/vendor/ssrdump",
+    "/data/vendor/tombstones",
+    "/data/vendor/wlan_logs",
+]
diff --git a/devices/diting.toml b/devices/diting.toml
new file mode 100644
index 0000000..d282290
--- /dev/null
+++ b/devices/diting.toml
@@ -0,0 +1,193 @@
+[device]
+codename = "diting"
+brand = "Redmi"
+model = "Redmi K50 Ultra"
+ab = true
+soc = { hans = "第一代骁龙®8+移动平台", hant = "Snapdragon® 8+ Gen 1 行動平台", en = "Snapdragon® 8+ Gen 1 Mobile Platform" }
+os_version_prop = "ro.mi.os.version.incremental"
+
+[display]
+# The panel's own mode, which the Chinese system runs the phone at: its
+# persist.sys.miui_resolution holds nothing, so nothing is scaled.
+width = 1220
+height = 2712
+density = 480
+diagonal = 6.67
+
+[modules]
+# The phone carries no system_dlkm: its modules are in the vendor_boot
+# ramdisk, in vendor_dlkm and in vendor. The vendor folder comes first
+# because goodix_core is in the ramdisk as well, listed there with fewer
+# dependencies, and the copy in the vendor folder is the one the system
+# loads, whose dependencies bring xiaomi_touch and msm_drm.
+sources = ["vendor", "vendor_boot", "vendor_dlkm"]
+# The touchscreen: Goodix GTX8 behind Xiaomi's touch layer. The phone also
+# carries FocalTech's driver, which binds no device here. Both are named,
+# under the two names the driver has been given across the phone's builds,
+# because a build carries only the one its own panels were fitted with and
+# a name it does not carry is skipped rather than stopping the boot.
+# The binder driver comes first: on the kernels whose build keeps it out of
+# the kernel itself, nothing that registers a service opens a device that
+# is not there, and the phone's own recovery loads it for that reason.
+# The Goodix driver is left to the service below, which puts the files it
+# reads through the firmware loader where the loader looks first: those
+# files are on the vendor partition, under a folder the phone's own table
+# mounts the modem image over.
+load = ["binder_gki", "fts_touch_spi", "focaltech_fts", "qcom-hv-haptics"]
+
+# What turns the controller's raw frames into touches is Xiaomi's touch
+# feature service, and a recovery runs none of it: the driver reports
+# positions itself, which this leaves on as the phone's system has it.
+[touch]
+writes = [{ path = "/sys/class/touch/touch_dev/enable_touch_raw", value = "0" }]
+
+# The WLAN firmware is on the modem partition, which the phone mounts at
+# /vendor/firmware_mnt and its own recovery leaves unmounted.
+[firmware]
+partition = "modem"
+
+# persist, which the phone mounts at /mnt/vendor/persist and its own
+# recovery leaves unmounted: the WLAN's MAC address is there, and so is
+# what the key service needs for a key that cannot be rolled back.
+[partitions]
+mounted = ["persist"]
+
+# The kernel loads goodix_core from the vendor_boot ramdisk before the
+# modem partition is mounted over /vendor/firmware, so the files the
+# driver asks for are not there yet and it gives up. They are on the
+# vendor partition, under the folder the modem image covers: the driver
+# is given them through the first folder the firmware loader looks in,
+# which the vendor image's own copy of them is not under.
+# The modem image is left as it is. It carries the WLAN's firmware, and
+# a driver that asks for a file it cannot find takes the phone down.
+# A build that carries the driver elsewhere, or has none, is left as it
+# is: nothing is put in the loader's folder for it.
+[[service]]
+path = "/vendor/bin/sh"
+args = ["-c", '''
+slot=$(getprop ro.boot.slot_suffix)
+mkdir -p /mnt/skyward-vendor /etc/firmware
+if mount -o ro /dev/block/mapper/vendor$slot /mnt/skyward-vendor 2>/dev/null; then
+    for name in goodix_cfg_group_l12.bin goodix_firmware_l12.bin goodix_cfg_group_l12_new.bin goodix_firmware_l12_new.bin; do
+        if [ -f "/mnt/skyward-vendor/firmware/$name" ]; then
+            cp "/mnt/skyward-vendor/firmware/$name" "/etc/firmware/$name"
+        fi
+    done
+    umount -l /mnt/skyward-vendor 2>/dev/null
+fi
+for module in /vendor/lib/modules/goodix_core.ko /vendor_dlkm/lib/modules/goodix_core.ko /lib/modules/goodix_core.ko; do
+    if [ -f "$module" ]; then
+        rmmod goodix_core 2>/dev/null
+        insmod "$module"
+        break
+    fi
+done
+umount -l /mnt/skyward-vendor 2>/dev/null
+true
+''']
+oneshot = true
+user = "root"
+groups = ["root", "system"]
+
+# What the phone's own init runs once the system has finished starting.
+# The kernel starts both CPU clusters on the performance governor, which
+# holds them at their highest clock, and Qualcomm's idle driver keeps
+# idle CPUs from powering down until the script tells it otherwise;
+# without it the phone heats up while the recovery sits idle.
+[[service]]
+path = "/vendor/bin/sh"
+args = ["/vendor/bin/init.kernel.post_boot.sh"]
+libraries = ["/system/lib64", "/vendor/lib64"]
+oneshot = true
+user = "root"
+groups = ["root", "system", "wakelock", "graphics"]
+
+# WLAN: Qualcomm's QCA6490 on the cnss2 platform driver, its firmware on
+# the modem partition. The driver reads its settings and the MAC address
+# through the firmware loader, so both are handed over under the names it
+# asks for; the MAC is read from persist, which is mounted above, rather
+# than by mounting that partition a second time. Once fs_ready is
+# written, cnss2 powers the chip up and wlan0 appears.
+#
+# The supplicant is the vendor partition's own, built from Android 12: it
+# registers with the hardware service directory of that version and runs
+# on its libraries, which the recovery carries under /skyward/hidl/a<sdk>.
+# The version is filled in from the stock image as the image is packed.
+# The system's own copies come after, if at all.
+[wlan]
+modules = ["qca_cld3_qca6490"]
+writes = [{ path = "/sys/kernel/cnss/fs_ready", value = "1" }]
+release = [{ path = "/sys/kernel/cnss/fs_ready", value = "0" }]
+firmware = [
+    { name = "wlan/qca_cld/qca6490/WCNSS_qcom_cfg.ini", path = "/vendor/etc/wifi/qca6490/WCNSS_qcom_cfg.ini" },
+    { name = "wlan/qca_cld/qca6490/wlan_mac.bin", path = "/mnt/vendor/persist/qca6490/wlan_mac.bin", optional = true },
+]
+interface = "wlan0"
+supplicant = "/vendor/bin/hw/wpa_supplicant"
+libraries = ["/skyward/hidl/a{sdk}/lib", "/vendor/lib64"]
+service = "android.hardware.wifi.supplicant.ISupplicant/default"
+probe = "http://connect.rom.miui.com/generate_204"
+# The chip's own coming up takes the better part of ten seconds once its
+# driver is in, which its user would wait at the switch: it is brought up
+# as the recovery starts instead.
+prewarm = true
+# Told the chip as the supplicant starts. Where none is told it keeps the
+# world-safe channels, which hold none of the higher 5 GHz ones a router
+# here sits on, so a network on one of those is never reached.
+country = "CN"
+
+# The update server the stock updater of the Chinese system asks.
+[update]
+server = "https://update.miui.com/updates/miotaV3.php"
+
+# The stock build the recovery is made on: the Chinese system's
+# OS3.0.2.0, whose system is Android 15 while its vendor stays Android 12,
+# and whose full package on the phone maker's server holds the recovery
+# partition the recovery is built on top of.
+[stock]
+version = "OS3.0.2.0.VLFCNXM"
+package = "https://bkt-sgp-miui-ota-update-alisgp.oss-ap-southeast-1.aliyuncs.com/OS3.0.2.0.VLFCNXM/diting-ota_full-OS3.0.2.0.VLFCNXM-user-15.0-315cddb555.zip"
+recovery = "c4c720dd058a7526570bc956222577dd323409781a318a5021f99aec0a740fe8"
+
+# qcom-hv-haptics. The phone measures the motor as it boots, 169.8 Hz
+# here, and the driver plays samples at that frequency. The system's own
+# clicks feel as one at a quarter of this, and past three quarters the
+# motor rattles. The driver takes no effect lighter than half its drive:
+# its converter does not run below that, and a lighter one is turned down
+# rather than played weakly, so this is where the slider's low end is.
+[haptics]
+resonance = "/sys/class/qcom-haptics/lra_frequency_hz"
+strength = { lightest = 0.5, strongest = 1.0 }
+
+# The partitions a backup of the baseband and EFS takes: the baseband's
+# settings, with the IMEI, and the sensors' calibration. And what of the
+# data partition a backup leaves out because the secure world keeps it in
+# step with itself: its own storage, its apps' data, that of Xiaomi's own
+# trusted environment, the secure element's state and the fingerprint
+# templates.
+[backup]
+efs = ["modemst1", "modemst2", "fsg", "fsc", "persist"]
+data_skipped = [
+    "vendor/tzstorage",
+    "vendor/qtee",
+    "vendor/mitee",
+    "vendor/goodix",
+    "vendor/fingerprint",
+    "vendor/fpdata",
+    "vendor/misc/mi_fp",
+]
+
+# Where the phone's own programs keep logs in the data partition: the
+# system's, the minidumps, what Xiaomi's log manager keeps of each part of
+# the phone, and what the modem and Wi-Fi leave when they crash.
+[wipe]
+logs = [
+    "/data/miuilog",
+    "/data/vendor/diag",
+    "/data/vendor/bsplog",
+    "/data/vendor/log",
+    "/data/vendor/ramdump",
+    "/data/vendor/ssrdump",
+    "/data/vendor/tombstones",
+    "/data/vendor/wlan_logs",
+]
diff --git a/devices/manet.toml b/devices/manet.toml
new file mode 100644
index 0000000..b65ad05
--- /dev/null
+++ b/devices/manet.toml
@@ -0,0 +1,141 @@
+[device]
+codename = "manet"
+brand = "Redmi"
+model = "REDMI K70 Pro"
+ab = true
+soc = { hans = "第三代骁龙®8移动平台", hant = "Snapdragon® 8 Gen 3 行動平台", en = "Snapdragon® 8 Gen 3 Mobile Platform" }
+os_version_prop = "ro.mi.os.version.incremental"
+
+[display]
+# The panel's own mode: persist.sys.miui_default_resolution in the running
+# system says 1440 by 3200, and ro.sf.lcd_density says 560. The system starts
+# in the lower mode the phone ships with, 1080 by 2400 at 420
+# (persist.sys.miui_resolution), as the K80's does; a recovery runs the
+# panel's own mode, as on the K80.
+width = 1440
+height = 3200
+density = 560
+diagonal = 6.67
+
+[modules]
+sources = ["vendor_boot", "vendor_dlkm", "vendor", "system_dlkm"]
+# The touchscreen: Goodix's, behind Xiaomi's touch layer, the touch drivers
+# the phone's own modules.load lists (xiaomi_touch, then goodix_core, which
+# the layer is used by; goodix_fod beside them for the reader under the
+# screen, which a recovery has no use for).
+load = ["xiaomi_touch", "goodix_core"]
+
+# As on the K80, no init script of the phone's starts touch_report: the touch
+# feature service turns the controller's raw frames into touches with
+# /odm/lib64/libtouchreport.so, and a recovery runs none of it. Told through
+# Xiaomi's touch layer at /sys/class/touch/touch_dev, the driver has the
+# controller report positions itself.
+[touch]
+writes = [{ path = "/sys/class/touch/touch_dev/enable_touch_raw", value = "0" }]
+
+# The persist partition is not mounted here: the recovery mounts it
+# read-only itself while it reads the WLAN's MAC address from it, and a
+# partition mounted twice, once as ext4 and once as the loader's read-only
+# mount, fails with "device or resource busy".
+
+# What the phone's own init runs once the system has finished starting, as
+# kernel-post-boot in /vendor/etc/init/hw/init.qti.kernel.rc, for the
+# pineapple platform this phone and the K80 share: the kernel starts the CPU
+# clusters on the performance governor, which holds them at their highest
+# clock; the script hands them to WALT, lets idle CPUs power down and sets how
+# the memory bus scales.
+[[service]]
+path = "/vendor/bin/sh"
+args = ["/vendor/bin/init.kernel.post_boot.sh"]
+libraries = ["/system/lib64", "/vendor/lib64"]
+oneshot = true
+user = "root"
+groups = ["root", "system", "wakelock", "graphics"]
+
+# WLAN: the kiwi_v2 node in the device tree, driven by qca_cld3_kiwi_v2, the
+# one WLAN driver the phone's own modules.load lists for the chip it has
+# (cnss2 and icnss2 under it). Its cfg80211 asks for rfkill, one of the
+# kernel's own modules in system_dlkm, as the K80's does. Its recovery covers
+# the vendor partition's firmware folder with the modem's, as the K80's does,
+# so the settings and the MAC address are given to the loader again: the
+# settings from the vendor partition, the address from the phone's own file
+# in persist (kiwi_v2/wlan_mac.bin there). wpa_supplicant runs on the
+# recovery's own libraries before the vendor partition's.
+[wlan]
+modules = ["rfkill", "qca_cld3_kiwi_v2"]
+writes = [{ path = "/sys/kernel/cnss/fs_ready", value = "1" }]
+release = [{ path = "/sys/kernel/cnss/fs_ready", value = "0" }]
+firmware = [
+    { name = "wlan/qca_cld/kiwi_v2/WCNSS_qcom_cfg.ini", path = "/vendor/etc/wifi/kiwi_v2/WCNSS_qcom_cfg.ini" },
+    { name = "wlan/qca_cld/kiwi_v2/wlan_mac.bin", partition = "persist", path = "kiwi_v2/wlan_mac.bin", optional = true },
+]
+interface = "wlan0"
+supplicant = "/vendor/bin/hw/wpa_supplicant"
+libraries = ["/system/lib64", "/vendor/lib64"]
+service = "android.hardware.wifi.supplicant.ISupplicant/default"
+probe = "http://connect.rom.miui.com/generate_204"
+# The WLAN comes up with the pages, so that the date and time it sets are
+# already right on the first screen, and the networks the phone saved are
+# joined without the page being opened.
+on_boot = true
+
+# The phone's keymint service does not come up in this recovery (its own
+# libraries want a newer libc++ than the recovery carries), so the pages do
+# not wait the whole twenty seconds for it: they come up after six.
+[boot]
+ready = 6
+# The data partition of this phone is not encrypted, so it is mounted as the
+# pages come up: its files and the networks the phone saved are there at once,
+# with nothing to be opened or typed first.
+open_data = true
+
+# The update server the stock updater of the Chinese system asks.
+[update]
+server = "https://update.miui.com/updates/miotaV3.php"
+
+# The stock build the recovery is made on: the Chinese system's OS3.0.307.0.WNMCNXM.
+[stock]
+version = "OS3.0.307.0.WNMCNXM"
+package = "https://bkt-sgp-miui-ota-update-alisgp.oss-ap-southeast-1.aliyuncs.com/OS3.0.307.0.WNMCNXM/manet-ota_full-OS3.0.307.0.WNMCNXM-user-16.0-01c57af24f.zip"
+recovery = "f436c69ac47cd99a08b2cd88be94296408c1b5db98ed8093fe2181929a7da5b1"
+
+# qcom-hv-haptics (qcom,hv-haptics in its dtbo), whose driver says the
+# motor's resonant frequency in /sys/class/qcom-haptics/lra_frequency_hz as
+# the K80's does; the click is made from samples at that frequency, and the
+# strengths are the K80's.
+[haptics]
+resonance = "/sys/class/qcom-haptics/lra_frequency_hz"
+strength = { lightest = 0.25, strongest = 0.75 }
+
+# The partitions a backup of the baseband and EFS takes: the baseband's
+# settings, with the IMEI, and the sensors' calibration. And what of the data
+# partition a backup leaves out because the secure world keeps it in step
+# with itself: its own storage, its apps' data, that of Xiaomi's own trusted
+# environment, the secure element's state and the fingerprint templates.
+[backup]
+efs = ["modemst1", "modemst2", "fsg", "fsc", "persist"]
+data_skipped = [
+    "vendor/tzstorage",
+    "vendor/qtee",
+    "vendor/mitee",
+    "vendor/goodix",
+    "vendor/fingerprint",
+    "vendor/fpdata",
+    "vendor/misc/mi_fp",
+]
+
+# Where the phone's own programs keep logs in the data partition: the
+# system's, the minidumps, what Xiaomi's log manager keeps of each part of
+# the phone, and what the modem, Wi-Fi and Bluetooth leave when they crash.
+[wipe]
+logs = [
+    "/data/miuilog",
+    "/data/vendor/diag",
+    "/data/vendor/bsplog",
+    "/data/vendor/log",
+    "/data/vendor/ramdump",
+    "/data/vendor/ramdump_ssr",
+    "/data/vendor/ssrdump",
+    "/data/vendor/tombstones",
+    "/data/vendor/wlan_logs",
+]
