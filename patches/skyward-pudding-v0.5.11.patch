+        ("位置", a.dir.clone()),
+        ("占用", crate::fmt::file_size(a.size)),
+        ("安装", crate::fmt::datetime(l, a.installed, s.zone())),
+        ("更新", crate::fmt::datetime(l, a.updated, s.zone())),
+    ];
+    let y = widgets::info_card(&mut c, t, f, top, &facts);
