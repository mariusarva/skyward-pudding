+            Lang::Hant => format!("已儲存：{file}（{secs} 秒）"),
+            Lang::En => format!("Saved: {file} ({secs} s)"),
+        };
+        self.say(&text, now);
+        self.dirty = true;
+        self.refresh();
+    }
