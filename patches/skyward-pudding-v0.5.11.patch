+                file: copy.file,
+                size: copy.size,
+                sha256: copy.sha256,
+                made: copy.made,
+            })),
+            Err(e) => refused = Some(format!("{e:#}")),
+        }
+    }
+    // A place that could not be read is said as the page's own error rather
+    // than swallowed: an empty list there would look like no backups at all.
+    match refused {
