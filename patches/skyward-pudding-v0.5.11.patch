+        for ev in told {
+            match ev {
+                modules::Event::Ended(Ok(manager)) => {
+                    self.app.module_installed(&manager, now);
+                    ended = true;
+                }
+                modules::Event::Ended(Err(why)) => {
+                    self.app.report(&why, now);
+                    ended = true;
+                }
+            }
+        }
+        if ended {
+            self.modules_worker = None;
+            self.app.set_modules(modules::read());
+        }
+    }
