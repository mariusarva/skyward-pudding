+        let Some(after) = rest[at + close..].strip_prefix("](") else { break };
+        let Some(end) = after.find(')') else { break };
+        out.push_str(&rest[at + 1..at + close]);
+        rest = &after[end + 1..];
+    }
+    out.push_str(rest);
