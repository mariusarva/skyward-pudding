+  if (NULL != splid_le0_index_)
+    free(splid_le0_index_);
+  splid_le0_index_ = NULL;
+
+  if (NULL != nodes_ge1_)
+    free(nodes_ge1_);
+  nodes_ge1_ = NULL;
+
+  if (NULL != nodes_ge1_)
+    free(nodes_ge1_);
+  nodes_ge1_ = NULL;
+
+  if (free_dict_list) {
+    if (NULL != dict_list_) {
+      delete dict_list_;
+    }
+    dict_list_ = NULL;
