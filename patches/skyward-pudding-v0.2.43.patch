--- a/crates/skyward/src/touchprobe.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/skyward/src/touchprobe.rs	2026-11-12 05:54:31.319034445 +0000
@@ -0,0 +1,87 @@
+//! Whether this phone's touch driver takes the Xiaomi common-data ioctl that
+//! switches double tap on. Read only: the mode found is put back as it was.
+
+use std::os::fd::AsRawFd;
+
+#[repr(C)]
+struct CommonData {
+    touch_id: i8,
+    cmd: u8,
+    mode: u16,
+    data_len: u16,
+    data: [i32; 256],
+}
+
+const _: () = assert!(std::mem::size_of::<CommonData>() == 1032);
+const COMMON: u32 = (3 << 30) | (1032 << 16) | ((b'T' as u32) << 8);
+const SELECT: u32 = ((b'T' as u32) << 8) | 3;
+/// The sub-command that reads and writes the double tap mode.
+const DOUBLE_TAP: u16 = 14;
+
+/// One call of the ioctl: `cmd` 1 asks for a value to be read or written of
+/// sub-command `sub`, and what comes back is what the driver holds.
+fn call(file: &std::fs::File, cmd: u8, sub: u16, value: i32, id: i8) -> std::io::Result<i32> {
+    let mut data = CommonData { touch_id: id, cmd, mode: sub, data_len: 1, data: [0; 256] };
+    data.data[0] = value;
+    let answered = unsafe { libc::ioctl(file.as_raw_fd(), COMMON as _, &mut data) };
+    match answered < 0 {
+        true => Err(std::io::Error::last_os_error()),
+        false => Ok(data.data[0]),
+    }
+}
+
+/// Double tap switched on in the touch driver, so the controller reports a
+/// wake gesture of its own instead of the pages watching for two taps.
+pub struct Gesture {
+    file: std::fs::File,
+    id: i8,
+    original: i32,
+}
+
+impl Gesture {
+    /// Ask the driver to report double taps. The panel may then rest, as it
+    /// used to, because the gesture is the controller's own.
+    pub fn enable(path: &str, id: i8) -> anyhow::Result<Self> {
+        let file = std::fs::OpenOptions::new().read(true).write(true).open(path)
+            .map_err(|e| anyhow::anyhow!("open {path}: {e}"))?;
+        if unsafe { libc::ioctl(file.as_raw_fd(), SELECT as _, id as libc::c_ulong) } < 0 {
+            return Err(std::io::Error::last_os_error()).map_err(|e| anyhow::anyhow!("select controller {id}: {e}"));
+        }
+        let original = call(&file, 1, DOUBLE_TAP, 0, id).map_err(|e| anyhow::anyhow!("read double tap: {e}"))?;
+        // Another client's mode is not this recovery's to change.
+        let blocked = call(&file, 1, 17, 0, id).map_err(|e| anyhow::anyhow!("read the touch mode: {e}"))?;
+        anyhow::ensure!(blocked == 0, "double tap is blocked by the touch mode {blocked}");
+        if original == 0 {
+            call(&file, 1, DOUBLE_TAP, 1, id).map_err(|e| anyhow::anyhow!("switch double tap on: {e}"))?;
+        }
+        Ok(Self { file, id, original })
+    }
+}
+
+impl Drop for Gesture {
+    fn drop(&mut self) {
+        let _ = call(&self.file, 1, DOUBLE_TAP, self.original, self.id);
+    }
+}
+
+/// What the touch driver says about double tap, or why it says nothing.
+pub fn line() -> String {
+    for path in ["/dev/xiaomi-touch", "/dev/xiaomi_touch", "/dev/touch"] {
+        let Ok(file) = std::fs::OpenOptions::new().read(true).write(true).open(path) else { continue };
+        for id in 0..4i8 {
+            if unsafe { libc::ioctl(file.as_raw_fd(), SELECT as _, id as libc::c_ulong) } < 0 {
+                continue;
+            }
+            return match call(&file, 1, DOUBLE_TAP, 0, id) {
+                Ok(mode) => {
+                    // Put back what was read, so nothing is left changed.
+                    let _ = call(&file, 1, DOUBLE_TAP, mode, id);
+                    format!("the touch driver at {path} takes the common data ioctl for controller {id}; double tap is {mode}")
+                }
+                Err(e) => format!("the touch driver at {path} answered for controller {id} but not to double tap: {e}"),
+            };
+        }
+        return format!("{path} opened but no controller answered the select ioctl");
+    }
+    "no Xiaomi touch node came with this phone".to_string()
+}
