+/// itself through the bootloader, as `ro.boot.hardware.sku`, and through the
+/// kernel's command line where the property area has it not -- a ramdisk that
+/// holds several phones' configurations reads it before anything is mounted.
+#[cfg(target_os = "android")]
+fn device_config() -> Result<DeviceConfig> {
+    let named = skyward_sys::prop("ro.boot.hardware.sku")
+        .or_else(|| skyward_sys::prop("ro.boot.product.hardware.sku"))
+        .or_else(|| cmdline_value("androidboot.hardware.sku"))
+        .map(|name| name.trim().to_string())
+        .filter(|name| !name.is_empty());
+    if let Some(name) = &named {
+        let at = format!("/skyward/device-{name}.toml");
+        if Path::new(&at).is_file() {
+            skyward_sys::kmsg(&format!("the configuration for {name} is the one this ramdisk carries"))?;
+            return DeviceConfig::load(at);
+        }
+        skyward_sys::kmsg(&format!("this ramdisk carries no configuration for {name}; the one it was built with is used"))?;
+    } else {
+        skyward_sys::kmsg("the phone names itself nowhere; the configuration the ramdisk was built with is used")?;
+    }
+    DeviceConfig::load(Path::new("/").join(ramdisk::CONFIG))
+}
+
+/// What the kernel was told at `key=`, where it was told it.
