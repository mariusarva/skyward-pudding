+
+impl QrCodeEcc {
+	
+	// Returns an unsigned 2-bit integer (in the range 0 to 3).
+	fn ordinal(self) -> usize {
+		use QrCodeEcc::*;
+		match self {
+			Low      => 0,
+			Medium   => 1,
+			Quartile => 2,
+			High     => 3,
+		}
+	}
+	
+	
+	// Returns an unsigned 2-bit integer (in the range 0 to 3).
+	fn format_bits(self) -> u8 {
+		use QrCodeEcc::*;
+		match self {
+			Low      => 1,
+			Medium   => 0,
+			Quartile => 3,
+			High     => 2,
+		}
+	}
+	
+}
