+/// Handing the folder the file manager shows to another device on the
+/// network, which reaches it with a browser.
+pub fn serve(cx: &Ctx) -> Frame {
+    let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
+    let m = &t.m;
+    let mut c = long_page(cx);
+    let mut out = Vec::new();
+    let mut y = widgets::section(&mut c, t, f, m.content_top, l.pick(["传输", "傳輸", "Transfer"]));
+    let folder = &s.files.path;
+    let row = Row::new(l.pick(["文件夹", "資料夾", "Folder"]))
+        .icon(BLUE, Icon::Folder)
+        .subtitle(folder)
+        .trail(Trail::Value(l.pick(["更改", "更改", "Change"])));
+    let pick = widgets::list(&mut c, t, f, y, &[row]);
+    out.extend(hits(&pick.rows, &[Action::ServePick]));
+    y = widgets::section(&mut c, t, f, pick.bottom, l.pick(["服务", "服務", "Server"]));
+    let on = matches!(s.serving, crate::app::Serving::Running { .. });
+    let mut line = Row::new(l.pick(["启动服务", "啟動服務", "Serve"]))
+        .icon(if on { GREEN } else { SLATE }, Icon::Globe)
+        .trail(Trail::Switch(on));
+    if let crate::app::Serving::Failed(why) = &s.serving {
+        line = line.subtitle(why);
+    }
+    let run = widgets::list(&mut c, t, f, y, &[line]);
+    out.extend(hits(&run.rows, &[Action::ServeToggle]));
+    y = run.bottom;
+    if let crate::app::Serving::Running { at, served } = &s.serving {
+        let n = *served;
+        let said = tr!(l, "已应答 {n} 次请求", "已回應 {n} 次請求", "{n} requests answered");
+        widgets::info_card(&mut c, t, f, y + m.card_gap, &[
+            (l.pick(["地址", "位址", "Address"]), at.clone()),
+            (l.pick(["请求", "請求", "Requests"]), said),
+        ]);
+    } else {
+        let hint = l.pick([
+            "在同一网络下用浏览器打开上面的地址，即可上传或下载这个文件夹里的文件。",
+            "在同一網路下用瀏覽器開啟上面的位址，即可上傳或下載這個資料夾裡的檔案。",
+            "Open the address above in a browser on the same network to move files in and out of this folder.",
+        ]);
+        widgets::footnote(&mut c, t, f, y, hint);
+    }
+    Frame::new(t, c, out, l.pick(SERVE), m.content_top)
+}
