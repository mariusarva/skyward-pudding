+            Touch::Up if matches!(self.drag, Drag::RecordPill { .. }) => {
+                let Drag::RecordPill { moved, dot, stop, .. } = self.drag else { unreachable!() };
+                self.drag = Drag::Idle;
+                if moved {
+                    return Some(vec![Effect::Haptic]);
