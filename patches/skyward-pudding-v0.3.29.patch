+            Row::new(l.pick(["写回它的分区", "寫回它的分割區", "Write it back"]))
+                .subtitle(l.pick(["整份核对过再写，核对不过就不写", "整份核對過再寫，核對不過就不寫", "Checked whole before anything is written"]))
+                .trail(Trail::Check(s.image_action == ImageAction::Restore)),
+            Row::new(l.pick(["删除这份镜像", "刪除這份映像檔", "Delete it"])).trail(Trail::Check(s.image_action == ImageAction::Delete)),
+        ],
+    );
+    out.extend(hits(
+        &choices.rows,
+        &[Action::ImageAction(ImageAction::Restore), Action::ImageAction(ImageAction::Delete)],
+    ));
+    // 再读一遍：从电脑上拷进来的镜像，不用离开这一页就能看见。
+    let again = widgets::list(
+        &mut c,
+        t,
+        f,
+        choices.bottom,
+        &[Row::new(l.pick(["重新读取镜像", "重新讀取映像檔", "Read the images again"])).icon(BLUE, Icon::Restore)],
+    );
+    out.extend(hits(&again.rows, &[Action::ImageRefresh]));
+    let y = widgets::footnote(
+        &mut c,
+        t,
+        f,
+        again.bottom + t.m.card_gap,
+        l.pick([
+            "导出会写进 Skyward/backup，并在旁边留一份 sha256；写回之前整份核对一遍。",
+            "匯出會寫進 Skyward/backup，並在旁邊留一份 sha256；寫回之前整份核對一遍。",
+            "Exports go into Skyward/backup with a sha256 beside them, and are checked whole before they are written back.",
+        ]),
+    );
+    let which = match s.image_action {
+        ImageAction::Restore => Confirm::ImageRestore,
+        ImageAction::Delete => Confirm::ImageDelete,
+    };
+    let (label, danger) = confirm_label(which, s);
+    let track = widgets::confirm(&mut c, t, f, y + t.m.dp(24.0), label, danger, s.confirm);
+    out.push(Hit { rect: track, action: Action::Confirm(which) });
+    Frame::new(t, fit(c, t, track.y + track.h), out, l.pick(IMAGE_BACKUP), top)
+}
+
+/// 分区在导出那一行下面的一句：多重，super 另外说明。
+fn image_size_note(l: Lang, name: &str, size: u64) -> String {
+    if name == "super" {
+        format!(
+            "{} \u{b7} {}",
+            fmt::bytes(size),
+            l.pick(["共享分区，包含双槽逻辑分区", "共用分割區，包含雙槽邏輯分割區", "Shared, holds both slots' logical partitions"])
+        )
+    } else {
+        fmt::bytes(size)
+    }
+}
+
+/// 一份镜像下面的一句：多大、什么时候写的、有没有校验。
+fn image_copy_note(l: Lang, copy: &ImageCopy) -> String {
+    let checked = match copy.sha256 {
+        Some(_) => l.pick(["有校验", "有核對", "checked"]),
+        None => l.pick(["无校验", "無核對", "no checksum"]),
+    };
+    format!("{} \u{b7} {} \u{b7} {checked}", fmt::bytes(copy.size), date_of(copy.made))
+}
+
+/// 秒数写成 `YYYY-MM-DD HH:MM`（按 UTC）；读不懂就留一个短横。
+fn date_of(seconds: i64) -> String {
+    if seconds <= 0 {
+        return "\u{2014}".to_string();
+    }
+    let days = seconds / 86_400;
+    let rest = seconds % 86_400;
+    let (mut year, mut day) = (1970i64, days);
+    loop {
+        let leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
+        let length = if leap { 366 } else { 365 };
+        if day < length {
+            break;
+        }
+        day -= length;
+        year += 1;
+    }
+    let leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
+    let months = [31, if leap { 29 } else { 28 }, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+    let mut month = 0;
+    while month < 12 && day >= months[month] {
+        day -= months[month];
+        month += 1;
+    }
+    format!("{year:04}-{:02}-{:02} {:02}:{:02}", month + 1, day + 1, rest / 3600, rest % 3600 / 60)
+}
+
+const IMAGE_BACKUP: Text = ["镜像备份", "映像檔備份", "Partition images"];
+
+/// 一份 vbmeta 副本下面的一句：哪一路槽位、多大、回滚索引是多少。
+fn vbmeta_copy_note(l: Lang, copy: &VbmetaCopy) -> String {
+    let slot = match copy.suffix.is_empty() {
+        true => l.pick(["槽位不明", "槽位不明", "slot unknown"]),
+        false => &copy.suffix,
+    };
+    let index = match &copy.rollback {
+        Ok(index) => tr!(l, "回滚索引 {index}", "回滾索引 {index}", "rollback {index}"),
+        Err(_) => l.pick(["回滚索引读不出", "回滾索引讀不出", "rollback unreadable"]).to_string(),
+    };
+    format!("{slot} \u{b7} {} \u{b7} {index}", fmt::bytes(copy.size))
+}
+
 pub fn unhandled(cx: &Ctx) -> Frame {
     let (t, f, s, l) = (cx.t, cx.f, cx.state, cx.state.lang);
     let mut c = page(cx);
diff -ruN '--exclude=target' '--exclude=.git' a/crates/skyward-ui/src/pinyin.rs b/crates/skyward-ui/src/pinyin.rs
--- a/crates/skyward-ui/src/pinyin.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/crates/skyward-ui/src/pinyin.rs	2026-11-19 14:28:06.502067786 +0000
@@ -0,0 +1,134 @@
+//! Offline AOSP decoder; input stays in memory and private temporary files.
+#[cfg(feature = "pinyin-input")]
+use std::{
+    ffi::CString,
+    sync::{Mutex, OnceLock},
+};
+
+#[cfg(feature = "pinyin-input")]
+unsafe extern "C" {
+    fn im_open_decoder(system: *const std::ffi::c_char, user: *const std::ffi::c_char) -> bool;
+    fn im_set_max_lens(spelling: usize, characters: usize);
+    fn skyward_pinyin_query(input: *const std::ffi::c_char, index: usize, output: *mut u16, capacity: usize, consumed: *mut usize)
+    -> usize;
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Candidate {
+    pub text: String,
+    pub consumed: usize,
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Composition {
+    pub enabled: bool,
+    pub spelling: String,
+    pub page: usize,
+    pub candidates: Vec<Candidate>,
+}
+
+impl Composition {
+    pub fn update(&mut self) {
+        self.candidates = candidates(&self.spelling);
+        self.page = 0;
+    }
+    pub fn clear(&mut self) {
+        self.spelling.clear();
+        self.candidates.clear();
+        self.page = 0;
+    }
+    pub fn choose(&mut self, index: usize) -> Option<String> {
+        let candidate = self.candidates.get(index)?.clone();
+        self.spelling.drain(..candidate.consumed.min(self.spelling.len()));
+        self.spelling = self.spelling.trim_start_matches('\'').into();
+        self.update();
+        Some(candidate.text)
+    }
+}
+
+#[cfg(feature = "pinyin-input")]
+struct Engine {
+    _files: tempfile::TempDir,
+}
+#[cfg(feature = "pinyin-input")]
+impl Engine {
+    fn open() -> Option<Self> {
+        let files = tempfile::Builder::new().prefix("skyward-pinyin-").tempdir_in("/tmp").ok()?;
+        let system = files.path().join("system.dat");
+        let user = files.path().join("user.dat");
+        std::fs::write(&system, include_bytes!(concat!(env!("OUT_DIR"), "/res/raw/dict_pinyin.dat"))).ok()?;
+        let (system, user) = (CString::new(system.to_str()?).ok()?, CString::new(user.to_str()?).ok()?);
+        // The C decoder's singleton is owned by this process-wide mutex.
+        if !unsafe { im_open_decoder(system.as_ptr(), user.as_ptr()) } {
+            return None;
+        }
+        unsafe {
+            im_set_max_lens(32, 16);
+        }
+        Some(Self { _files: files })
+    }
+}
+
+#[cfg(not(feature = "pinyin-input"))]
+pub fn candidates(_: &str) -> Vec<Candidate> {
+    Vec::new()
+}
+
+#[cfg(feature = "pinyin-input")]
+pub fn candidates(spelling: &str) -> Vec<Candidate> {
+    if spelling.is_empty() || spelling.len() > 32 || !spelling.bytes().all(|c| c.is_ascii_lowercase() || c == b'\'') {
+        return Vec::new();
+    }
+    static ENGINE: OnceLock<Mutex<Option<Engine>>> = OnceLock::new();
+    let Ok(engine) = ENGINE.get_or_init(|| Mutex::new(Engine::open())).lock() else {
+        return Vec::new();
+    };
+    if engine.is_none() {
+        return Vec::new();
+    }
+    let input = CString::new(spelling).expect("validated ASCII spelling");
+    let mut result = Vec::new();
+    for index in 0..24 {
+        let mut text = [0u16; 64];
+        let mut consumed = 0;
+        let count = unsafe { skyward_pinyin_query(input.as_ptr(), index, text.as_mut_ptr(), text.len(), &mut consumed) };
+        if index >= count {
+            break;
+        }
+        let end = text.iter().position(|c| *c == 0).unwrap_or(text.len());
+        if end > 0
+            && consumed > 0
+            && let Ok(text) = String::from_utf16(&text[..end])
+        {
+            result.push(Candidate { text, consumed });
+        }
+    }
+    result
+}
+
+#[cfg(all(test, feature = "pinyin-input"))]
+mod tests {
+    use super::*;
+    #[test]
+    fn real_dictionary_decodes_chinese_and_keeps_a_bounded_candidate_list() {
+        let result = candidates("nihao");
+        assert!(result.iter().any(|c| c.text == "你好"), "{result:?}");
+        assert!(result.len() <= 24);
+        for invalid in ["", "../../data", "你", "ni hao", "0123"] {
+            assert!(candidates(invalid).is_empty());
+        }
+        assert!(candidates(&"a".repeat(33)).is_empty());
+    }
+    #[test]
+    fn choosing_a_phrase_consumes_its_spelling_without_committing_raw_letters() {
+        let mut composition = Composition {
+            enabled: true,
+            spelling: "nihao".into(),
+            ..Composition::default()
+        };
+        composition.update();
+        let index = composition.candidates.iter().position(|c| c.text == "你好").unwrap();
+        assert_eq!(composition.choose(index).as_deref(), Some("你好"));
+        assert!(composition.spelling.is_empty());
+    }
+}
