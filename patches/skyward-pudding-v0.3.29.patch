+MileStoneHandle UserDict::extend_dict(MileStoneHandle from_handle,
+                                      const DictExtPara *dep,
+                                      LmaPsbItem *lpi_items,
+                                      size_t lpi_max, size_t *lpi_num) {
+  if (is_valid_state() == false)
