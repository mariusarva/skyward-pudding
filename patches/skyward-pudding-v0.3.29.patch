 [stock]
-version = "OS4.0.4.0.XPBCNXM"
-package = "https://bkt-sgp-miui-ota-update-alisgp.oss-ap-southeast-1.aliyuncs.com/OS4.0.4.0.XPBCNXM/popsicle-ota_full-OS4.0.4.0.XPBCNXM-user-17.0-7d13a10bbc.zip"
