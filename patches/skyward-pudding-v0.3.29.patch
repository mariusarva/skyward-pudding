+fn length(head: &[u8]) -> usize {
+    let auth = u64::from_be_bytes(head[12..20].try_into().expect("eight bytes")) as usize;
+    let aux = u64::from_be_bytes(head[20..28].try_into().expect("eight bytes")) as usize;
