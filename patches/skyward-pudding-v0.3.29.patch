+        assert_eq!(&fs::read(&target).unwrap()[..22], b"boot the slot's kernel", "the image went in whole, over what the partition held");
+        assert_eq!(at.last().copied(), Some((fs::metadata(&image).unwrap().len(), fs::metadata(&image).unwrap().len())));
