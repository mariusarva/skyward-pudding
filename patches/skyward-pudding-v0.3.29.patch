+  root_ = NULL;
+  dumb_node_ = NULL;
+  splitter_node_ = NULL;
+  instance_ = NULL;
+  ym_buf_ = NULL;
+  f2h_ = NULL;
+
+  szm_enable_shm(true);
+  szm_enable_ym(true);
