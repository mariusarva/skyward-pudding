+/// 一台手机上装着的应用，按安装时间从新到旧。
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct DataApp {
+    /// 包名，也是 `/data/app` 里文件夹名去掉后面那段散列。
+    pub package: String,
+    /// `/data/app` 里的那个文件夹。
+    pub dir: String,
+    /// 应用自己起的名字，认不出来就退回包名。
