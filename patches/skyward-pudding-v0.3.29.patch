+DictTrie::~DictTrie() {
+  free_resource(true);
+}
+
+void DictTrie::free_resource(bool free_dict_list) {
+  if (NULL != root_)
+    free(root_);
+  root_ = NULL;
+
+  if (NULL != splid_le0_index_)
+    free(splid_le0_index_);
+  splid_le0_index_ = NULL;
+
+  if (NULL != nodes_ge1_)
+    free(nodes_ge1_);
+  nodes_ge1_ = NULL;
+
+  if (NULL != nodes_ge1_)
+    free(nodes_ge1_);
+  nodes_ge1_ = NULL;
+
+  if (free_dict_list) {
+    if (NULL != dict_list_) {
+      delete dict_list_;
+    }
+    dict_list_ = NULL;
+  }
+
+  if (parsing_marks_)
+    delete [] parsing_marks_;
+  parsing_marks_ = NULL;
+
+  if (mile_stones_)
+    delete [] mile_stones_;
+  mile_stones_ = NULL;
+
+  reset_milestones(0, kFirstValidMileStoneHandle);
+}
