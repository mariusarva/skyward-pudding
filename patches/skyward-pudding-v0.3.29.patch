+                // 右边的方块：结束这一段，和录屏页的「停止录制」是同一条路。
+                if stop {
+                    let mut effects = self.record_toggle(now);
+                    effects.push(Effect::Haptic);
+                    return Some(effects);
+                }
+                match dot {
+                    true => Some(self.record_paused(now)),
+                    false => Some(vec![Effect::Haptic]),
+                }
+            }
+            _ => None,
+        }
+    }
