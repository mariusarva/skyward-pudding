+    /// 「完成」的圆心跟时间数字的墨迹中心在同一条水平线上，日期也在这条
+    /// 线上：三样一眼看过去是一排（2026-11-22）。
+    #[test]
+    fn the_done_circle_sits_on_the_clock_s_line() {
+        use crate::app::testing::*;
+        let (f, i) = (fonts(), info());
+        let mut app = App::new(Screen::Home, W, H, PPD);
+        app.shade = 1.0;
