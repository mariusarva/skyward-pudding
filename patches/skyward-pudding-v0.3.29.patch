+    #[test]
+    fn stopping_leaves_the_work_where_it_stood() {
+        let dir = scratch();
+        let root = dir.path();
+        // 比一段还大：一段读完才看得见停止。
+        let image = image_with(root, "boot-1.img", &vec![7u8; 5 << 20]);
+        let stop = AtomicBool::new(false);
+        let mut counted = 0;
+        let error = digest(&image, &stop, &mut |_, _| {
+            counted += 1;
+            stop.store(true, Ordering::Relaxed);
