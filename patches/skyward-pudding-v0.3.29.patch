+        let chosen = (self.state.record.scale, self.state.record.quality, self.state.record.fps, self.state.record.format);
+        self.state.record = Record {
+            on: true,
+            since: now,
+            file,
+            spec,
+            elapsed: "0:00".into(),
+            frames: 0,
+            scale: chosen.0,
+            quality: chosen.1,
+            fps: chosen.2,
+            format: chosen.3,
