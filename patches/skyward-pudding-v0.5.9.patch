+        tempfile::tempdir().expect("a temporary folder")
+    }
+
+    fn image_with(root: &Path, name: &str, bytes: &[u8]) -> PathBuf {
+        let path = root.join(name);
+        fs::write(&path, bytes).expect("write the image");
