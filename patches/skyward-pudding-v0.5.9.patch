+    part.push(".part");
+    fs::copy(library, &part).with_context(|| format!("copy {} to {}", library.display(), Path::new(&part).display()))?;
+    fs::rename(&part, &to).with_context(|| format!("put {} in place", to.display()))?;
+    Ok(to)
