+        Some(tenths) => fmt::watts(tenths),
+        None if b.is_some_and(|b| b.plugged) => l.pick(["读取中", "讀取中", "Reading"]).to_owned(),
+        None => l.pick(["未接充电器", "未接充電器", "No charger"]).to_owned(),
+    };
+    let most = match ch.most {
+        Some(tenths) => fmt::watts(tenths),
