+/// 组合用的控制字符：变体选择符（U+FE0E / U+FE0F）、零宽连接符（U+200D）和键帽
+/// 的合成符（U+20E3）自己不占位，也不该被当成豆腐块画出来。
+fn joining(ch: char) -> bool {
+    matches!(ch, '\u{fe0e}' | '\u{fe0f}' | '\u{200d}' | '\u{20e3}')
+}
