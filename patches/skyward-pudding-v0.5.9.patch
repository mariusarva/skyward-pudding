@@ -0,0 +1,707 @@
+//! 控制中心摆的磁贴：有哪几种、各叫什么、按什么顺序摆。
+//!
+//! 摆法存在 `/metadata/skyward/tiles` 里，一行一个磁贴的名字；没存过时
+//! 按 [`DEFAULT`] 摆。名字是给文件用的，改一个字就对不上旧文件。
+
+use super::*;
+
+/// 控制中心可以摆的一种磁贴。
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum Tile {
+    // 头十二个是原来那十二枚，也是没存过时的默认摆法：老用户升级上来
+    // 看到的面板跟以前一样，新加的十二枚在「添加磁贴」里等着。
+    Wlan,
+    Vibrate,
+    FileTransfer,
+    Usb,
+    Files,
+    Modules,
+    Partitions,
+    Terminal,
+    Record,
+    Screenshot,
+    Reboot,
+    Settings,
+    // 2026-11-22 追加：备份、恢复这些原来只在页面里点得到的东西。
+    Backup,
+    Restore,
+    Mount,
+    Filesystems,
+    Logs,
+    Advanced,
+    DataApps,
+    Systems,
+    ImageBackup,
+    PowerOff,
+    Fetch,
+    ScreenOff,
+    /// 充电设置：充电器在给多少功率，以及充电档位与温控。
+    Charge,
+    /// Root 管理：KernelSU / Magisk 的写入、备份与模块。
+    Root,
+}
+
+/// 没存过时摆的：原来那十二枚，一行四个、三排。
+pub const DEFAULT: [Tile; 12] = [
+    Tile::Wlan,
+    Tile::Vibrate,
+    Tile::FileTransfer,
+    Tile::Usb,
+    Tile::Files,
+    Tile::Modules,
+    Tile::Partitions,
+    Tile::Terminal,
+    Tile::Record,
+    Tile::Screenshot,
+    Tile::Reboot,
+    Tile::Settings,
+];
+
+/// 全部磁贴，按默认摆的顺序排：前十二个是 [`DEFAULT`]，后面是后加的。
+pub const TILES: [Tile; 26] = [
+    Tile::Wlan,
+    Tile::Vibrate,
+    Tile::FileTransfer,
+    Tile::Usb,
+    Tile::Files,
+    Tile::Modules,
+    Tile::Partitions,
+    Tile::Terminal,
+    Tile::Record,
+    Tile::Screenshot,
+    Tile::Reboot,
+    Tile::Settings,
+    Tile::Backup,
+    Tile::Restore,
+    Tile::Mount,
+    Tile::Filesystems,
+    Tile::Logs,
+    Tile::Advanced,
+    Tile::DataApps,
+    Tile::Systems,
+    Tile::ImageBackup,
+    Tile::PowerOff,
+    Tile::Fetch,
+    Tile::ScreenOff,
+    Tile::Charge,
+    Tile::Root,
+];
+
+impl Tile {
+    /// 存进文件的名字：认得出是哪一个就行。
+    pub fn id(self) -> &'static str {
+        match self {
+            Tile::Wlan => "wlan",
+            Tile::Vibrate => "vibrate",
+            Tile::FileTransfer => "mtp",
+            Tile::Usb => "usb",
+            Tile::Files => "files",
+            Tile::Modules => "modules",
+            Tile::Partitions => "partitions",
+            Tile::Terminal => "terminal",
+            Tile::Record => "record",
