+        return base;
+    }
+    // 编辑时设备状态卡之后：一行标题 + 候选磁贴（一排六个），最后留一点空。
+    let add_rows = (TILES.len().saturating_sub(tiles)).div_ceil(6).max(1);
+    base + m.dp(54.0) + add_rows as f32 * (m.dp(32.0) + m.dp(24.0)) + m.dp(22.0)
