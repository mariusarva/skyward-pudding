+LIBRARY_SRC= \
+	    ../share/dictbuilder.cpp \
+	    ../share/dictlist.cpp \
+	    ../share/dicttrie.cpp \
+	    ../share/lpicache.cpp \
+	    ../share/mystdlib.cpp \
+	    ../share/ngram.cpp \
+	    ../share/searchutility.cpp \
+	    ../share/spellingtable.cpp \
+	    ../share/spellingtrie.cpp \
