+/// 一个目录里的 apk：`base.apk` 优先，否则第一个 `.apk`。
+fn apk_in(dir: &std::path::Path) -> Option<std::path::PathBuf> {
+    let base = dir.join("base.apk");
+    if base.is_file() {
+        return Some(base);
+    }
+    let list = std::fs::read_dir(dir).ok()?;
+    list.flatten()
+        .map(|e| e.path())
+        .find(|p| p.extension().is_some_and(|x| x == "apk"))
+}
